{
	"name": "harka-group-website",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build:prod": "astro build",
		"build": "wrangler types --check && astro build",
		"preview": "wrangler dev",
		"preview:build": "wrangler types --check && astro build && wrangler dev",
		"astro": "astro",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:prod": "wrangler d1 migrations apply harka-db --remote",
		"db:migrate:dev": "wrangler d1 migrations apply harka-db --local",
		"db:studio": "drizzle-kit studio",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"check": "wrangler types --check && prettier --check . && astro check && eslint ."
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.1.7",
		"@astrojs/mdx": "7.0.5",
		"@astrojs/netlify": "8.1.3",
		"@astrojs/svelte": "^9.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.1.6",
		"harka-group-website": ".",
		"drizzle-orm": "^0.45.2",
		"embla-carousel": "^8.6.0",
		"embla-carousel-autoplay": "^8.6.0",
		"glightbox": "^3.3.1",
		"slugify": "^1.6.9",
		"svelte": "^5.56.8",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.118.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.1",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"gray-matter": "^4.0.3",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"svelte-eslint-parser": "^1.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	}
}
