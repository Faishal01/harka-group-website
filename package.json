{
  "name": "harka-group-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter=web run dev",
    "dev:admin": "bun --filter=admin run dev",
    "dev:all": "bun --filter='*' run dev",
    "build:web": "bun --filter=web run build",
    "build:admin": "bun --filter=admin run build",
    "gen:web": "bun --filter=web run gen",
    "gen:admin": "bun --filter=admin run gen",
    "preview:build:web": "bun --filter=web run build && bunx wrangler dev -c ./apps/web/dist/server/wrangler.json --persist-to ./.wrangler/state",
    "preview:build:admin": "bun --filter=admin run build && bunx wrangler dev -c ./apps/admin/dist/server/wrangler.json --persist-to ./.wrangler/state",
    "db:push": "bun --filter=web run db:push",
    "db:generate": "bun --filter=web run db:generate",
    "db:migrate:prod": "bun --filter=web run db:migrate:prod",
    "db:migrate:dev": "bun --filter=web run db:migrate:dev",
    "db:studio": "bun --filter=web run db:studio",
    "format": "bun --filter='*' run format",
    "lint": "bun --filter='*' run lint",
    "check": "bun --filter='*' run check"
  }
}
