{
	"name": "gas",
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"chart.js": "^4.5.1",
		"preact": "^11.0.1",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gas-plugin/unplugin": "^0.2.2",
		"@google/clasp": "^3.4.1",
		"@iconify-json/lucide": "^1.2.147",
		"@preact/preset-vite": "^2.10.6",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@types/google-apps-script": "^2.0.13",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.4",
		"vite-plugin-singlefile": "^2.3.4"
	},
	"private": true,
	"scripts": {
		"build:script": "vite build --config vite.config.script.ts",
		"build:ui": "vite build --config vite.config.ui.ts",
		"build": "vite build --config vite.config.script.ts && vite build --config vite.config.ui.ts",
		"push": "vite build --config vite.config.script.ts && vite build --config vite.config.ui.ts && clasp push",
		"deploy": "vite build --config vite.config.script.ts && vite build --config vite.config.ui.ts && clasp push && clasp deploy",
		"clasp": "clasp",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"check": "prettier --check . && tsc --noEmit && eslint ."
	},
	"type": "module"
}
