---
export const prerender = false;
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import Button from "~/components/Button.astro";
import Heading from "~/components/Heading.astro";

import ShowCars from "~/components/ShowCars.astro";
import { homePage } from "~/data/captions";
import { siteName, siteSlogan } from "~/data/config";
import { SITE_URL, generateAutoDealerSchema, DEALER_LOCATION } from "~/utils/seo";

// Images
import ImageHeadingBackground from "~/assets/images/WhatsApp_Image_2026-09-22_at_23.25.09.jpeg";
import CtaTextures from "~/assets/images/prew-o.jpg";

const autoDealerSchema = generateAutoDealerSchema(SITE_URL);
const metaDescription = `${siteSlogan}. Jual beli & tukar tambah mobil bekas berkualitas di ${DEALER_LOCATION} dengan garansi bebas tabrak & banjir.`;
---

<Layout
	pageTitle={`${siteName} | Showroom Mobil Bekas Berkualitas ${DEALER_LOCATION}`}
	title={`${siteName} - Showroom Mobil Bekas`}
	description={metaDescription}
	canonicalUrl={SITE_URL}
	schema={autoDealerSchema}
>
	{/* Main Heading */}
	<Section class:list={"relative"}>
		<Image
			src={ImageHeadingBackground}
			alt="Heading background"
			class:list={"absolute inset-0 w-full h-full object-cover"}
		/>
		<div class="absolute inset-0 w-full h-full object-cover bg-gray-800/80"></div>
		<Container class:list={"relative z-10"}>
			<Heading class:list={"prose-invert max-w-4xl"}>
				<h1 slot="heading-title" class="mb-0 lg:text-7xl text-balance">
					{homePage.headingTitle}
				</h1>
				<p slot="heading-content">
					{homePage.headingContent}
				</p>
			</Heading>
			<div class="flex justify-center mt-8">
				<Button href="/cars" color="white" class:list={"px-8 py-3 text-lg"}
					>{homePage.browseButtonLabel}</Button
				>
			</div>
		</Container>
	</Section>

	{/* Recent Cars */}
	<Section class:list={"bg-gray-50"}>
		<Container>
			<Heading>
				<h2 slot="heading-title" class="mb-0">{homePage.recentTitle}</h2>
				<p slot="heading-content">{homePage.recentContent}</p>
			</Heading>

			<ShowCars ui="grid" recent />
		</Container>
	</Section>

	{/* CTA */}
	<Section
		class:list={"relative overflow-hidden bg-linear-to-br from-gray-900/20 via-gray-800/50 to-gray-950/20"}
	>
		<Image
			src={CtaTextures}
			alt=""
			aria-hidden="true"
			class:list={"absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-overlay pointer-events-none select-none"}
		/>
		<Container class:list={"relative z-10"}>
			<Heading class:list={"mb-0 lg:mb-0 prose-invert text-center mx-auto"}>
				<h2 slot="heading-title">{homePage.ctaTitle}</h2>

				<p slot="heading-content">{homePage.ctaContent}</p>

				<Button href="/contact" color="white" class:list={"mt-8"}>{homePage.contactUsLabel}</Button>
			</Heading>
		</Container>
	</Section>
</Layout>
