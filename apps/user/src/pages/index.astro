---
export const prerender = false;

import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import Button from "~/components/Button.astro";
import Heading from "~/components/Heading.astro";
import StockFeed from "~/components/home/StockFeed.svelte";
import FaqSection from "~/components/home/FaqSection.svelte";
import { faqItems } from "~/data/faq";
import { homePage } from "~/data/captions";
import { siteName } from "~/data/config";
import { SITE_URL, generateAutoDealerSchema, DEALER_LOCATION } from "~/utils/seo";
import { env } from "cloudflare:workers";
import { createCore } from "@harka/core";
import type { Car } from "~/types";
import type { Promo } from "@harka/db";
import ImageHeadingBackground from "~/assets/images/WhatsApp_Image_2026-09-22_at_23.25.09.jpeg";
import CtaTextures from "~/assets/images/prew-o.jpg";

const core = createCore(env);

// Initial query params
const searchParamsRecord = Object.fromEntries(Astro.url.searchParams.entries());
const initialSearch = searchParamsRecord.search || "";
const initialMake = searchParamsRecord.make || "all";
const initialSort = searchParamsRecord.sort || "date-desc";

// Fetch distinct makes for filter chips
const availableMakes = await core.cars.getDistinctMakes({ adminView: false }).catch(() => []);

// Fetch initial paginated cars for SSR rendering
let initialCars: Car[];
let totalCount: number;
try {
	const result = await core.cars.getFilteredPaginated(
		{ ...searchParamsRecord, page: 1, pageSize: 12 },
		{ adminView: false },
	);
	initialCars = result.cars;
	totalCount = result.total;
} catch {
	initialCars = [];
	totalCount = 0;
}

// Fetch 6 latest available (non-sold) cars for homepage featured carousel
let latestCars: Car[] = [];
try {
	latestCars = await core.cars.getLatestAvailable(6);
} catch (err) {
	console.error("Failed to load latest cars:", err);
}

// Fetch active promos for homepage promo bar
let activePromos: Promo[] = [];
try {
	activePromos = await core.promos.getActive();
} catch (err) {
	console.error("Failed to load active promos:", err);
}

const autoDealerSchema = generateAutoDealerSchema(SITE_URL);
const faqSchema =
	faqItems.length > 0
		? {
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: faqItems.map((item) => ({
					"@type": "Question",
					name: item.question,
					acceptedAnswer: {
						"@type": "Answer",
						text: item.answer,
					},
				})),
			}
		: null;
const pageSchemas = [autoDealerSchema, faqSchema].filter(Boolean) as Record<string, unknown>[];
const metaDescription = `Katalog lengkap mobil bekas berkualitas & bergaransi di ${siteName} ${DEALER_LOCATION}. Pilihan unit prima, inspeksi bebas tabrak & banjir, harga transparan dan tukar tambah mudah.`;
---

<Layout
	pageTitle={`${siteName} | Showroom & Katalog Mobil Bekas Berkualitas ${DEALER_LOCATION}`}
	title={`${siteName} - Showroom Mobil Bekas`}
	description={metaDescription}
	canonicalUrl={SITE_URL}
	schema={pageSchemas}
>
	<StockFeed
		client:load
		backgroundImageSrc={ImageHeadingBackground.src}
		initialCars={initialCars}
		totalCount={totalCount}
		availableMakes={availableMakes}
		initialSearch={initialSearch}
		initialMake={initialMake}
		initialSort={initialSort}
		promos={activePromos}
		latestCars={latestCars}
	/>

	{faqItems.length > 0 && <FaqSection client:visible items={faqItems} />}

	{/* CTA Section */}
	<Section
		class:list={"relative overflow-hidden bg-linear-to-br from-gray-900/20 via-gray-800/50 to-gray-950/20"}
	>
		<Image
			src={CtaTextures}
			alt=""
			aria-hidden="true"
			class:list={"absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-overlay pointer-events-none select-none"}
		/>
		<Container class:list={"relative z-10"}>
			<Heading class:list={"mb-0 lg:mb-0 prose-invert text-center mx-auto"}>
				<h2 slot="heading-title">{homePage.ctaTitle}</h2>
				<p slot="heading-content">{homePage.ctaContent}</p>
				<Button href="/contact" color="white" class:list={"mt-8"}>
					{homePage.contactUsLabel}
				</Button>
			</Heading>
		</Container>
	</Section>
</Layout>
