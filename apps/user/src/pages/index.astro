---
export const prerender = false;

import Layout from "~/layouts/Layout.astro";
import StockFeed from "~/components/home/StockFeed.svelte";
import { siteName } from "~/data/config";
import { SITE_URL, generateAutoDealerSchema, DEALER_LOCATION } from "~/utils/seo";
import { env } from "cloudflare:workers";
import { createCore } from "@harka/core";
import { getDb, cars as carsTable } from "@harka/db";
import { and, isNull, eq, asc } from "drizzle-orm";
import type { Car } from "~/types";
import ImageHeadingBackground from "~/assets/images/WhatsApp_Image_2026-09-22_at_23.25.09.jpeg";

const core = createCore(env);
const db = getDb(env);

// Initial query params
const searchParamsRecord = Object.fromEntries(Astro.url.searchParams.entries());
const initialSearch = searchParamsRecord.search || "";
const initialMake = searchParamsRecord.make || "all";
const initialSort = searchParamsRecord.sort || "date-desc";

// Fetch distinct makes for filter chips
const makeRows = (await db
	.selectDistinct({ make: carsTable.make })
	.from(carsTable)
	.where(and(isNull(carsTable.deletedAt), eq(carsTable.hidden, false)))
	.orderBy(asc(carsTable.make))) as { make: string }[];
const availableMakes = makeRows.map((r) => r.make).filter(Boolean);

// Fetch initial cars for SSR rendering
let allMatchingCars: Car[];
try {
	allMatchingCars = await core.cars.getFiltered(searchParamsRecord, {
		adminView: false,
	});
} catch {
	allMatchingCars = [];
}

const totalCount = allMatchingCars.length;
const initialCars = allMatchingCars.slice(0, 12);

const autoDealerSchema = generateAutoDealerSchema(SITE_URL);
const metaDescription = `Katalog lengkap mobil bekas berkualitas & bergaransi di ${siteName} ${DEALER_LOCATION}. Pilihan unit prima, inspeksi bebas tabrak & banjir, harga transparan dan tukar tambah mudah.`;
---

<Layout
	pageTitle={`${siteName} | Showroom & Katalog Mobil Bekas Berkualitas ${DEALER_LOCATION}`}
	title={`${siteName} - Showroom Mobil Bekas`}
	description={metaDescription}
	canonicalUrl={SITE_URL}
	schema={autoDealerSchema}
>
	<StockFeed
		client:load
		backgroundImageSrc={ImageHeadingBackground.src}
		initialCars={initialCars}
		totalCount={totalCount}
		availableMakes={availableMakes}
		initialSearch={initialSearch}
		initialMake={initialMake}
		initialSort={initialSort}
	/>
</Layout>
