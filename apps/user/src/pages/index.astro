---
export const prerender = false;

import Layout from "~/layouts/Layout.astro";
import HeroPromoCarousel from "~/components/home/HeroPromoCarousel.svelte";
import HeroDiscovery from "~/components/home/HeroDiscovery.svelte";
import FeaturedCarsCarousel from "~/components/home/FeaturedCarsCarousel.svelte";
import FaqSection from "~/components/home/FaqSection.svelte";
import { faqItems } from "~/data/faq";
import { siteName } from "~/data/config";
import { SITE_URL, generateAutoDealerSchema, DEALER_LOCATION } from "~/utils/seo";
import { env } from "cloudflare:workers";
import { createCore } from "@harka/core";
import type { Car } from "~/types";
import type { Promo } from "@harka/db";

// Backward compatibility: redirect legacy catalog query links on / to /cars
const legacyFilterKeys = ["search", "make", "sort", "bodyType", "price"];
if (legacyFilterKeys.some((k) => Astro.url.searchParams.has(k))) {
	return Astro.redirect(`/cars${Astro.url.search}`, 302);
}

const core = createCore(env);

const [availableMakes, latestCars, activePromos] = await Promise.all([
	core.cars.getDistinctMakes({ adminView: false }).catch(() => [] as string[]),
	core.cars.getLatestAvailable(6).catch(() => [] as Car[]),
	core.promos.getActive().catch(() => [] as Promo[]),
]);

const autoDealerSchema = generateAutoDealerSchema(SITE_URL);
const faqSchema =
	faqItems.length > 0
		? {
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: faqItems.map((item) => ({
					"@type": "Question",
					name: item.question,
					acceptedAnswer: {
						"@type": "Answer",
						text: item.answer,
					},
				})),
			}
		: null;
const pageSchemas = [autoDealerSchema, faqSchema].filter(Boolean) as Record<string, unknown>[];
const metaDescription = `Showroom & katalog mobil bekas berkualitas & bergaransi di ${siteName} ${DEALER_LOCATION}. Pilihan unit prima, inspeksi bebas tabrak & banjir, harga transparan dan tukar tambah mudah.`;

const sellBenefits = [
	{
		title: "Estimasi Cepat",
		description: "Ajukan data kendaraan secara online dan terima estimasi harga awal dengan cepat.",
	},
	{
		title: "Inspeksi Transparan",
		description: "Pengecekan unit jujur dan profesional tanpa biaya tersembunyi.",
	},
	{
		title: "Pembayaran Aman",
		description: "Proses transaksi aman, dokumen terjamin, dan pencairan dana tepat waktu.",
	},
];
---

<Layout
	pageTitle={`${siteName} | Showroom & Katalog Mobil Bekas Berkualitas ${DEALER_LOCATION}`}
	title={`${siteName} - Showroom Mobil Bekas`}
	description={metaDescription}
	canonicalUrl={SITE_URL}
	schema={pageSchemas}
>
	<!-- HERO: FULL-WIDTH PROMO CAROUSEL + OVERLAPPING SEARCH & QUICK DISCOVERY -->
	<section class="bg-gray-50 border-b border-gray-200/80 pb-6 sm:pb-8">
		{activePromos.length > 0 && <HeroPromoCarousel client:load promos={activePromos} />}

		<div
			class={`max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 ${
				activePromos.length > 0 ? "mt-4 sm:-mt-10" : "pt-6 sm:pt-8"
			}`}
		>
			<HeroDiscovery client:load availableMakes={availableMakes} />
		</div>
	</section>

	<!-- FEATURED LATEST CARS CAROUSEL -->
	<FeaturedCarsCarousel client:load cars={latestCars} viewMoreHref="/cars" />

	<!-- SELL & TRADE-IN CONVERSION BAND -->
	<section class="bg-white border-b border-gray-200 py-12 sm:py-16">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div
				class="rounded-3xl bg-gradient-to-br from-gray-900 via-gray-900 to-red-950 text-white p-6 sm:p-10 lg:p-12 shadow-xl overflow-hidden"
			>
				<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
					<div class="max-w-2xl space-y-4">
						<span
							class="inline-block px-3 py-1 rounded-full bg-red-600/20 border border-red-500/40 text-red-300 text-xs font-bold uppercase tracking-wider"
						>
							Jual & Tukar Tambah
						</span>
						<h2 class="text-2xl sm:text-3xl font-bold font-header text-white leading-tight">
							Ingin Jual atau Tukar Tambah Mobil Anda?
						</h2>
						<p class="text-sm sm:text-base text-gray-300 leading-relaxed">
							Dapatkan penawaran harga terbaik untuk mobil lama Anda atau tukar langsung dengan unit
							pilihan di showroom kami.
						</p>

						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
							{
								sellBenefits.map((item) => (
									<div class="rounded-xl bg-white/5 border border-white/10 p-3.5">
										<p class="text-sm font-bold text-white">{item.title}</p>
										<p class="text-xs text-gray-300 mt-1 leading-relaxed">{item.description}</p>
									</div>
								))
							}
						</div>
					</div>

					<div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
						<a
							href="/trade-in?type=trade_in"
							class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm sm:text-base shadow-lg transition text-center"
						>
							Tukar Tambah Sekarang
						</a>
						<a
							href="/trade-in?type=sell"
							class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white hover:bg-gray-100 text-gray-900 font-bold text-sm sm:text-base shadow transition text-center"
						>
							Jual Mobil Anda
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	{faqItems.length > 0 && <FaqSection client:visible items={faqItems} />}
</Layout>
