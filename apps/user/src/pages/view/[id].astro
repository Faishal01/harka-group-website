---
import { maskPlateNumber, getDb, cars as carsTable } from "@harka/db";
import { createCore } from "@harka/core";
import { and, desc, eq, isNull, ne, notInArray } from "drizzle-orm";
import type { Car } from "~/types";

import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import IconLogo from "~/assets/images/icons/logo.svg";

// UI Components
import Slider from "~/components/car/single-page/Slider.astro";
import Price from "~/components/car/single-page/Price.astro";
import FeatureBox from "~/components/car/single-page/FeatureBox.astro";
import FeaturesList from "~/components/car/single-page/FeaturesList.astro";
import SimilarCars from "~/components/car/single-page/SimilarCars.astro";
import FormInquire from "~/components/forms/Inquire.astro";
import ModalSlider from "~/components/modals/ModalSlider.astro";

// Buttons
import ButtonGoBack from "~/components/buttons/ButtonGoBack.astro";
import ButtonShare from "~/components/buttons/ButtonShare.astro";
import ButtonCall from "~/components/buttons/ButtonCall.astro";
import ButtonInquire from "~/components/buttons/ButtonInquire.astro";
import { env } from "cloudflare:workers";
import { viewPage } from "~/data/captions";
import { getPrice } from "~/utils/helpers";

import {
	SITE_URL,
	formatCarMetaTitle,
	formatCarMetaDesc,
	generateCarSchema,
	generateAutoDealerSchema,
	generateBreadcrumbSchema,
	resolveImageUrl,
} from "~/utils/seo";

export const prerender = false;

const { id } = Astro.params;

const core = createCore(env);
const rawCar = id ? await core.cars.getById(id, { adminView: false }).catch(() => null) : null;

const notFound = !rawCar;
if (notFound) {
	Astro.response.status = 404;
}

// Server-side masking: raw plate number never enters user context
const car = rawCar
	? {
			...rawCar,
			plateNumber: maskPlateNumber(rawCar.plateNumber),
		}
	: null;

const isSold = car?.archiveReason === "sold";
const effectivePrice = car?.promoPrice && car.promoPrice < car.price ? car.promoPrice : car?.price;
const pageTitle = car ? formatCarMetaTitle(car) : "404 - Mobil Tidak Ditemukan";
const pageDescription = car ? formatCarMetaDesc(car) : "Unit mobil tidak ditemukan";
const coverImageKey = car?.gallery?.[0]?.image;
const ogImage = resolveImageUrl(coverImageKey, SITE_URL);
const vehicleName = car ? `${car.year ? `${car.year} ` : ""}${car.make} ${car.model}` : "";

// Fetch up to 4 similar active cars when viewing a sold unit (same make first, then same bodyType)
let similarCars: Car[] = [];
if (isSold && car) {
	try {
		const db = getDb(env);
		const baseConditions = [
			isNull(carsTable.deletedAt),
			eq(carsTable.hidden, false),
			isNull(carsTable.archiveReason),
			ne(carsTable.id, car.id),
		];

		const sameMakeCars = (await db
			.select()
			.from(carsTable)
			.where(and(...baseConditions, eq(carsTable.make, car.make)))
			.orderBy(desc(carsTable.publishDate))
			.limit(4)) as Car[];

		similarCars = sameMakeCars;

		if (similarCars.length < 4 && car.bodyType) {
			const excludeIds = [car.id, ...similarCars.map((c) => c.id)];
			const sameBodyCars = (await db
				.select()
				.from(carsTable)
				.where(
					and(
						isNull(carsTable.deletedAt),
						eq(carsTable.hidden, false),
						isNull(carsTable.archiveReason),
						notInArray(carsTable.id, excludeIds),
						eq(carsTable.bodyType, car.bodyType),
					),
				)
				.orderBy(desc(carsTable.publishDate))
				.limit(4 - similarCars.length)) as Car[];

			similarCars = [...similarCars, ...sameBodyCars];
		}
	} catch (err) {
		console.error("Failed to load similar cars:", err);
	}
}

const breadcrumbSchema = car
	? generateBreadcrumbSchema([
			{ name: "Beranda", url: "/" },
			{ name: car.make, url: `/?make=${encodeURIComponent(car.make)}` },
			{ name: vehicleName, url: `/view/${car.id}` },
		])
	: undefined;

const carSchema = car ? generateCarSchema(car, SITE_URL) : undefined;
const dealerSchema = generateAutoDealerSchema(SITE_URL);
const pageSchemas = [dealerSchema, carSchema, breadcrumbSchema].filter(Boolean) as Record<
	string,
	unknown
>[];
---

{
	notFound || !car ? (
		<Layout pageTitle="404 - Mobil Tidak Ditemukan" noindex>
			<Section class:list={"bg-gray-50 min-h-[60vh] flex items-center"}>
				<Container>
					<div class="mx-auto flex w-full max-w-2xl flex-col items-center justify-center text-center px-6 py-20">
						<p class="text-sm font-bold tracking-widest text-red-600 uppercase">404 - Not Found</p>
						<h1 class="h3 font-bold text-gray-900 mt-3">Mobil Tidak Ditemukan</h1>
						<p class="mt-4 text-base text-gray-600">
							Maaf, unit mobil yang Anda cari tidak tersedia, sedang disembunyikan, atau telah
							dihapus dari inventaris kami.
						</p>
						<div class="mt-8 flex flex-wrap justify-center gap-4">
							<a
								href="/"
								class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-gray-900 rounded-lg shadow hover:bg-gray-800 transition gap-2"
							>
								<span>←</span>
								<span>Lihat Stok Tersedia</span>
							</a>
						</div>
					</div>
				</Container>
			</Section>
		</Layout>
	) : (
		<Layout
			pageTitle={pageTitle}
			title={vehicleName}
			description={pageDescription}
			image={ogImage}
			imageAlt={`Foto mobil bekas ${vehicleName} di Harka Group`}
			ogType="product"
			productPrice={effectivePrice}
			productAvailability={isSold ? "out of stock" : "in stock"}
			canonicalUrl={`${SITE_URL}/view/${car.id}`}
			schema={pageSchemas}
		>
			<Section class:list={"bg-gray-50 max-lg:pb-20"}>
				<Container class:list={"pb-2 lg:pb-3 max-sm:pt-6 print:hidden"}>
					<nav
						aria-label="Breadcrumb"
						class="flex items-center gap-2 text-xs sm:text-sm text-gray-500 mb-4 overflow-x-auto whitespace-nowrap"
					>
						<a href="/" class="hover:text-gray-900 transition">
							Beranda
						</a>
						<span class="text-gray-400">/</span>
						<a
							href={`/?make=${encodeURIComponent(car.make)}`}
							class="hover:text-gray-900 transition"
						>
							{car.make}
						</a>
						<span class="text-gray-400">/</span>
						<span class="text-gray-900 font-medium truncate" aria-current="page">
							{vehicleName}
						</span>
					</nav>
					<ButtonGoBack />
				</Container>

				<Container class:list={"pt-0 lg:pt-0"}>
					<div class="bg-white rounded-2xl border border-gray-200/90 shadow-sm overflow-hidden">
						<div class="grid grid-cols-1 lg:grid-cols-12">
							<div id="gallery-wrapper" class="relative lg:col-span-7 p-3 sm:p-5 lg:p-6">
								{car.gallery && car.gallery.length > 0 ? (
									<Slider gallery={car.gallery} vehicleName={vehicleName} />
								) : (
									<div class="aspect-[4/3] rounded-xl text-gray-200 w-full bg-gray-50 border border-gray-200/80 flex flex-col gap-4 items-center justify-center">
										<IconLogo class="h-20" />
										<span class="text-gray-400 select-none font-bold italic text-sm">
											{viewPage.comingSoon}
										</span>
									</div>
								)}
							</div>

							<div class="lg:col-span-5 lg:border-l lg:border-gray-100">
								<div class="p-5 sm:p-6 lg:p-8 flex flex-col items-start h-full">
									<div class="w-full">
										<h1 class="text-xl sm:text-2xl font-bold text-gray-900 font-header leading-snug">
											{car.title}
										</h1>
									</div>

									{isSold ? (
										<div class="mt-5 mb-2">
											<span class="inline-block bg-red-600 text-white font-black text-3xl px-6 py-2 uppercase tracking-widest rounded-lg shadow-xs transform -skew-x-6">
												SOLD
											</span>
										</div>
									) : (
										<Price price={car.price} promoPrice={car.promoPrice} />
									)}

									{(car.isFloodFree || car.isAccidentFree) && (
										<div class="flex flex-wrap items-center gap-2 mt-4">
											{car.isFloodFree && car.isAccidentFree ? (
												<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200/70">
													<svg
														xmlns="http://www.w3.org/2000/svg"
														class="size-3.5 text-emerald-600 shrink-0"
														viewBox="0 0 20 20"
														fill="currentColor"
													>
														<path
															fill-rule="evenodd"
															d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
															clip-rule="evenodd"
														/>
													</svg>
													Bebas Banjir & Tabrak
												</span>
											) : (
												<>
													{car.isFloodFree && (
														<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200/70">
															Bebas Banjir
														</span>
													)}
													{car.isAccidentFree && (
														<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200/70">
															Bebas Tabrak
														</span>
													)}
												</>
											)}
										</div>
									)}

									<FeatureBox car={car} />

									<div class="mt-auto pt-5 border-t border-gray-100 flex flex-col gap-2.5 w-full print:hidden">
										<div class="flex items-center flex-wrap gap-2.5 w-full">
											{!isSold && (
												<>
													<ButtonCall
														car={car}
														url={`${SITE_URL}/view/${car.id}`}
														class="rounded-xl! py-2.5! px-4! text-sm!"
													/>
													<ButtonInquire class="rounded-xl! py-2.5! px-4! text-sm!" />
													<a
														href={`/trade-in?type=trade_in&targetCarId=${car.id}`}
														class="not-prose inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold transition duration-300 rounded-xl shadow-xs border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 hover:border-red-300 gap-1.5"
													>
														<svg
															xmlns="http://www.w3.org/2000/svg"
															class="size-4 shrink-0"
															viewBox="0 0 20 20"
															fill="currentColor"
														>
															<path
																fill-rule="evenodd"
																d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z"
																clip-rule="evenodd"
															/>
														</svg>
														<span>Tukar Tambah</span>
													</a>
												</>
											)}
											{car.relatedUrl && (
												<a
													href={car.relatedUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="not-prose inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold transition duration-300 rounded-xl shadow-xs border border-gray-300 bg-white text-gray-800 hover:bg-gray-50 hover:border-gray-400 gap-1.5"
												>
													<svg
														xmlns="http://www.w3.org/2000/svg"
														class="size-4 shrink-0 text-gray-600"
														fill="none"
														viewBox="0 0 24 24"
														stroke="currentColor"
													>
														<path
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="2"
															d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
														/>
													</svg>
													<span>Tautan Terkait</span>
												</a>
											)}
											<ButtonShare car={car} url={`${SITE_URL}/view/${car.id}`} />
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="border-t border-gray-100 p-5 sm:p-6 lg:p-8">
							<h2 class="text-base sm:text-lg font-bold text-gray-900 font-header flex items-center gap-2 mb-4">
								<span class="inline-block w-1 h-5 rounded-full bg-red-600" />
								<span>{viewPage.description}</span>
							</h2>
							<p class="whitespace-pre-line text-sm sm:text-base text-gray-700 leading-relaxed max-w-4xl">
								{car.excerpt || viewPage.noDescription}
							</p>
						</div>

						<div id="features-list" class="border-t border-gray-100 p-5 sm:p-6 lg:p-8">
							<FeaturesList car={car} />
						</div>

						{/* Form */}
						{!isSold && (
							<div
								id="ask-a-question"
								class="border-t border-gray-100 p-5 sm:p-6 lg:p-8 max-w-3xl print:hidden"
							>
								<FormInquire car={car} url={`${SITE_URL}/view/${car.id}`} />
							</div>
						)}
					</div>

					{isSold && similarCars.length > 0 && <SimilarCars cars={similarCars} />}
				</Container>
			</Section>

			<ModalSlider />

			{!isSold && (
				<div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-gray-200 p-3 shadow-lg flex items-center justify-between gap-3 print:hidden">
					<div class="min-w-0">
						<span class="text-xs text-gray-500 block truncate">{vehicleName}</span>
						{car.promoPrice && car.promoPrice < car.price ? (
							<div class="flex items-baseline gap-1.5 flex-wrap">
								<span class="text-xs text-gray-400 line-through font-medium">
									{getPrice(car.price)}
								</span>
								<span class="text-base font-extrabold text-red-700">
									{getPrice(car.promoPrice)}
								</span>
							</div>
						) : (
							<span class="text-base font-extrabold text-gray-900 block">
								{getPrice(car.price)}
							</span>
						)}
					</div>
					<ButtonCall
						car={car}
						url={`${SITE_URL}/view/${car.id}`}
						class="shrink-0 text-sm py-2 px-3.5"
					/>
				</div>
			)}
		</Layout>
	)
}

<script>
	import GLightbox from "glightbox";
	import "glightbox/dist/css/glightbox.min.css";

	// wait for the page to load
	document.addEventListener("astro:page-load", function () {
		GLightbox({ touchNavigation: true, loop: true });
	});
</script>
