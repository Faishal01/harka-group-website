---
export const prerender = false;

import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import CarImageSlider from "~/components/home/CarImageSlider.svelte";
import { siteName, phone } from "~/data/config";
import { SITE_URL } from "~/utils/seo";
import { getPrice, getMileage, getMileageUnit } from "~/utils/helpers";
import { transmissionMap, fuelTypeMap } from "~/data/constants";
import { env } from "cloudflare:workers";
import { createCore } from "@harka/core";
import type { Car, Promo } from "@harka/db";

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect("/404");
}

const core = createCore(env);

let promoData: { promo: Promo; cars: Car[] };
try {
	promoData = await core.promos.getBySlug(slug);
} catch {
	return Astro.redirect("/404");
}

const { promo, cars } = promoData;

// Inactive promo guardrail (allow bypass if preview query param is present)
const isPreview = Astro.url.searchParams.get("preview") === "true";
if (!promo.isActive && !isPreview) {
	return Astro.redirect("/404");
}

// Sorting logic
const sort = Astro.url.searchParams.get("sort") || "date-desc";

const sortedCars = [...cars].sort((a, b) => {
	const priceA = a.promoPrice && a.promoPrice < a.price ? a.promoPrice : a.price;
	const priceB = b.promoPrice && b.promoPrice < b.price ? b.promoPrice : b.price;

	switch (sort) {
		case "price-asc":
			return priceA - priceB;
		case "price-desc":
			return priceB - priceA;
		case "year-desc":
			return (b.year || 0) - (a.year || 0);
		case "year-asc":
			return (a.year || 0) - (b.year || 0);
		case "mileage-asc":
			return (a.mileage || 0) - (b.mileage || 0);
		case "date-desc":
		default:
			return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
	}
});

const pageTitle = `${promo.title} | Promo Spesial ${siteName}`;
const metaDescription =
	promo.description ||
	`Temukan penawaran terbaik untuk ${promo.title} di Showroom ${siteName}. Cek pilihan unit bergaransi sekarang!`;

const currentUrl = `${SITE_URL}/promo/${promo.slug}`;
const cleanPhone = phone.href.replace(/[^0-9]/g, "");
const waShareText = encodeURIComponent(
	`Promo Spesial ${promo.title} di ${siteName}!\nLihat penawaran unit mobil pilihan di sini:\n${currentUrl}`,
);
const waContactText = encodeURIComponent(
	`Halo ${siteName}, saya tertarik dengan promo *${promo.title}* (${currentUrl}). Boleh minta info detail lebih lanjut?`,
);
const waContactHref = `https://wa.me/${cleanPhone}?text=${waContactText}`;
const waShareHref = `https://wa.me/?text=${waShareText}`;

const mileageUnit = getMileageUnit();

const sortOptions = [
	{ value: "date-desc", label: "Terbaru" },
	{ value: "price-asc", label: "Harga Terendah" },
	{ value: "price-desc", label: "Harga Tertinggi" },
	{ value: "year-desc", label: "Tahun Terbaru" },
	{ value: "year-asc", label: "Tahun Terlama" },
	{ value: "mileage-asc", label: "Kilometer Terendah" },
];
---

<Layout
	pageTitle={pageTitle}
	title={promo.title}
	description={metaDescription}
	canonicalUrl={currentUrl}
	image={promo.bannerImage}
>
	<Section class="bg-gray-50 py-6 sm:py-10 min-h-[90vh]">
		<Container class="max-w-6xl">
			<!-- Breadcrumb -->
			<nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
				<a href="/" class="hover:text-red-700 transition">Beranda</a>
				<span>/</span>
				<span class="text-gray-400">Promo</span>
				<span>/</span>
				<span class="text-gray-800 font-medium truncate">{promo.title}</span>
			</nav>

			<!-- Hero: 2.5:1 Campaign Banner Strip -->
			<div
				class="relative w-full aspect-[2.5/1] rounded-2xl overflow-hidden shadow-xl border border-gray-200 bg-gray-900 group mb-8"
			>
				<img
					src={promo.bannerImage}
					alt={promo.title}
					class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent pointer-events-none"
				>
				</div>
			</div>

			<!-- Campaign Header & Actions -->
			<div
				class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-200 shadow-sm mb-10 flex flex-col md:flex-row md:items-start justify-between gap-6"
			>
				<div class="max-w-3xl">
					<div class="flex items-center gap-2 mb-2 flex-wrap">
						<span
							class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-50 text-red-700 border border-red-200"
						>
							Promo Spesial
						</span>
						{
							promo.mode === "filter" ? (
								<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
									Filter Otomatis
								</span>
							) : (
								<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200">
									Unit Pilihan Showroom
								</span>
							)
						}
					</div>

					<h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
						{promo.title}
					</h1>

					{
						promo.description && (
							<div class="prose text-gray-600 text-sm sm:text-base mt-3 leading-relaxed">
								<p class="whitespace-pre-line">{promo.description}</p>
							</div>
						)
					}

					<!-- Active Period Badge -->
					{
						(promo.startDate || promo.endDate) && (
							<div class="mt-4 flex items-center gap-2 text-xs text-gray-500 font-medium">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="size-4 text-red-600"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
									/>
								</svg>
								<span>
									Periode Promo:{" "}
									{promo.startDate
										? new Date(promo.startDate).toLocaleDateString("id-ID", {
												day: "numeric",
												month: "long",
												year: "numeric",
											})
										: "Sekarang"}{" "}
									-{" "}
									{promo.endDate
										? new Date(promo.endDate).toLocaleDateString("id-ID", {
												day: "numeric",
												month: "long",
												year: "numeric",
											})
										: "Selama persediaan masih ada"}
								</span>
							</div>
						)
					}
				</div>

				<!-- Actions: WhatsApp Contact & Share -->
				<div class="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0">
					<a
						href={waContactHref}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-red-700 hover:bg-red-800 text-white font-bold text-sm rounded-xl shadow-sm transition"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="size-5"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.123.557 4.116 1.531 5.845l-1.624 5.926 6.075-1.593c1.704.937 3.659 1.468 5.742 1.468 6.627 0 12-5.373 12-12s-5.373-12-12-12z"
							></path>
						</svg>
						<span>Tanya Sales Showroom</span>
					</a>

					<a
						href={waShareHref}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 px-4 py-2.5 border border-gray-300 hover:border-gray-400 text-gray-700 font-semibold text-xs rounded-xl hover:bg-gray-50 transition"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="size-4 text-emerald-600"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
							></path>
						</svg>
						<span>Bagikan Promo Ini</span>
					</a>
				</div>
			</div>

			<!-- Inventory Section Header & Sorting -->
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
				<div>
					<h2 class="text-xl sm:text-2xl font-bold text-gray-900">
						Unit Pilihan Promo ({sortedCars.length})
					</h2>
					<p class="text-xs text-gray-500 mt-0.5">
						Semua unit telah lulus inspeksi ketat dan siap dibawa pulang.
					</p>
				</div>

				<!-- Sort Dropdown -->
				<div class="flex items-center gap-2 self-start sm:self-auto">
					<label for="sort-select" class="text-xs font-semibold text-gray-500">Urutkan:</label>
					<select
						id="sort-select"
						class="px-3 py-2 bg-white border border-gray-300 rounded-xl text-xs font-semibold text-gray-700 focus:ring-2 focus:ring-red-600 outline-none cursor-pointer"
					>
						{
							sortOptions.map((opt) => (
								<option value={opt.value} selected={sort === opt.value}>
									{opt.label}
								</option>
							))
						}
					</select>
				</div>
			</div>

			<!-- Car Grid -->
			{
				sortedCars.length === 0 ? (
					<div class="bg-white rounded-2xl border border-gray-200 p-12 text-center max-w-lg mx-auto shadow-sm">
						<div class="size-16 bg-red-50 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="size-8"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
								/>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-gray-900 mb-1">Unit Sedang Habis</h3>
						<p class="text-sm text-gray-500 mb-6">
							Semua unit dalam kampanye promo ini telah terjual atau sedang dipersiapkan. Cek
							seluruh koleksi unit mobil kami di halaman beranda.
						</p>
						<a
							href="/"
							class="inline-flex items-center gap-2 bg-red-700 text-white font-bold px-6 py-3 rounded-xl hover:bg-red-800 transition shadow-sm text-sm"
						>
							&larr; Lihat Semua Stok Showroom
						</a>
					</div>
				) : (
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
						{sortedCars.map((car) => {
							const isSold = car.archiveReason === "sold";
							const rawMileage = car.mileage ?? 0;
							const formattedMileage = getMileage(rawMileage);
							const transmissionLabel = transmissionMap[car.transmission || ""] || car.transmission;
							const fuelLabel = fuelTypeMap[car.fuelType || ""] || car.fuelType;
							const isPromoPrice =
								car.promoPrice !== null &&
								car.promoPrice !== undefined &&
								car.promoPrice < car.price;

							return (
								<article
									data-car-id={car.id}
									class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200/90 flex flex-col h-full hover:border-red-600"
								>
									<a href={`/view/${car.id}`} class="flex flex-col h-full">
										<CarImageSlider
											client:idle
											gallery={car.gallery}
											title={car.title}
											isSold={isSold}
											carId={car.id}
										/>

										<div class="p-5 sm:p-6 flex flex-col grow">
											<div class="h-12 flex items-start mb-2 overflow-hidden">
												<h3 class="car-card-title text-base sm:text-lg font-bold text-gray-900 group-hover:text-red-700 transition-colors line-clamp-2 leading-snug">
													{car.title}
												</h3>
											</div>

											<div class="flex items-center gap-1.5 text-xs text-gray-500 mb-3 truncate">
												<span>
													{formattedMileage} {mileageUnit}
												</span>
												{transmissionLabel && (
													<>
														<span class="text-gray-300">•</span>
														<span>{transmissionLabel}</span>
													</>
												)}
												{fuelLabel && (
													<>
														<span class="text-gray-300">•</span>
														<span>{fuelLabel}</span>
													</>
												)}
												{car.year && (
													<>
														<span class="text-gray-300">•</span>
														<span>{car.year}</span>
													</>
												)}
											</div>

											<div class="mb-4 flex items-baseline gap-2 flex-wrap min-h-[1.75rem]">
												{isPromoPrice ? (
													<>
														<span class="text-xs sm:text-sm text-gray-400 line-through font-medium">
															{getPrice(car.price)}
														</span>
														<span class="text-lg sm:text-xl font-bold text-red-700 tracking-tight font-inter">
															{getPrice(car.promoPrice!)}
														</span>
													</>
												) : (
													<span class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight font-inter">
														{getPrice(car.price)}
													</span>
												)}
											</div>

											<div class="mt-auto pt-3 border-t border-gray-100 flex flex-wrap items-center gap-1.5">
												{car.isFloodFree && car.isAccidentFree && (
													<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-semibold border border-emerald-200/60">
														<svg
															xmlns="http://www.w3.org/2000/svg"
															class="size-3 text-emerald-600 shrink-0"
															viewBox="0 0 20 20"
															fill="currentColor"
														>
															<path
																fill-rule="evenodd"
																d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
																clip-rule="evenodd"
															/>
														</svg>
														Bebas Tabrak & Banjir
													</span>
												)}
												{car.ownershipStatus === "first_hand" && (
													<span class="inline-flex items-center px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-[11px] font-semibold border border-blue-200/60">
														Tangan Pertama
													</span>
												)}
												{car.seatingCapacity && (
													<span class="inline-flex items-center px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 text-[11px] font-medium">
														{car.seatingCapacity} Kursi
													</span>
												)}
											</div>
										</div>
									</a>
								</article>
							);
						})}
					</div>
				)
			}
		</Container>
	</Section>
</Layout>

<script>
	document.addEventListener("astro:page-load", () => {
		const select = document.getElementById("sort-select") as HTMLSelectElement | null;
		if (select) {
			select.addEventListener("change", (e) => {
				const target = e.target as HTMLSelectElement;
				const url = new URL(window.location.href);
				url.searchParams.set("sort", target.value);
				window.location.href = url.toString();
			});
		}
	});
</script>
