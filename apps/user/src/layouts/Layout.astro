---
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { siteName, siteLang, themeColor, siteSlogan } from "~/data/config";
import { SITE_URL, getCanonicalUrl } from "~/utils/seo";

interface Props {
	pageTitle?: string;
	title?: string;
	description?: string;
	noindex?: boolean;
	image?: string;
	imageAlt?: string;
	ogType?: "website" | "article" | "product";
	canonicalUrl?: string;
	schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	pageTitle,
	title,
	description = siteSlogan,
	noindex = false,
	image,
	imageAlt = `${siteName} - Showroom Mobil Bekas`,
	ogType = "website",
	canonicalUrl,
	schema,
} = Astro.props;

// Compute clean canonical URL
const canonical = canonicalUrl || getCanonicalUrl(Astro.url.pathname, SITE_URL);

// Resolve preview image URL to an absolute URL
const defaultImage = `${SITE_URL}/images/og-image.jpg`;
let ogImageUrl = defaultImage;

if (image) {
	if (image.startsWith("http://") || image.startsWith("https://")) {
		ogImageUrl = image;
	} else {
		ogImageUrl = `${SITE_URL}${image.startsWith("/") ? "" : "/"}${image}`;
	}
}

// Compute clean page title
const rawTitle = pageTitle || title;
const displayPageTitle = rawTitle
	? rawTitle.includes(siteName)
		? rawTitle
		: `${rawTitle} | ${siteName}`
	: `${siteName} | ${siteSlogan}`;

// Flatten schemas if passed
const schemasToRender = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonical} />
		<link rel="author" href="/humans.txt" />

		<!-- Favicons -->
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content={siteName} />

		<!-- OpenGraph / Facebook / WhatsApp -->
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={displayPageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={siteLang.replace("-", "_")} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={displayPageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<!-- Schema.org JSON-LD -->
		{
			schemasToRender.map((schemaItem) => (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaItem)} />
			))
		}

		<title>{displayPageTitle}</title>
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	document.addEventListener("astro:after-swap", () => {
		scrollTo({ top: history.state.scrollY, behavior: "instant" });
	});
</script>
