---
import type { TeamMember } from "@harka/db";
import IconWhatsApp from "~/assets/images/icons/social-media/whatsapp.svg";
import IconMail from "~/assets/images/icons/social-media/email.svg";

interface Props {
	members: TeamMember[];
}

const { members } = Astro.props;

function getInitials(name: string): string {
	return name
		.split(" ")
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() || "")
		.join("");
}
---

<ul
	role="list"
	class="mx-auto grid max-w-6xl grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3"
>
	{
		members.map((member) => {
			const cleanPhone = member.phone ? member.phone.replace(/[^0-9]/g, "") : null;
			return (
				<li class="text-center max-lg:max-w-xs mx-auto flex flex-col items-center">
					{member.photoUrl ? (
						<img
							src={member.photoUrl}
							alt={`Foto ${member.name}`}
							width="640"
							height="640"
							loading="lazy"
							decoding="async"
							class="mx-auto size-48 sm:size-56 xl:size-72 rounded-full object-cover shadow-sm ring-4 ring-gray-100 transition-transform duration-300 hover:scale-105"
						/>
					) : (
						<div class="mx-auto size-48 sm:size-56 xl:size-72 rounded-full bg-linear-to-br from-gray-100 to-gray-200 text-gray-500 font-bold text-3xl sm:text-4xl xl:text-5xl flex items-center justify-center shadow-inner ring-4 ring-gray-100 select-none transition-transform duration-300 hover:scale-105">
							{getInitials(member.name)}
						</div>
					)}

					<span class="mt-6 block text-lg font-semibold tracking-tight text-gray-900">
						{member.name}
					</span>

					{member.role && <p class="text-base text-gray-600 mt-1">{member.role}</p>}

					{(member.phone || member.email) && (
						<ul role="list" class="mt-6 flex justify-center gap-x-6">
							{member.phone && cleanPhone && (
								<li>
									<a
										href={`https://wa.me/${cleanPhone}`}
										target="_blank"
										rel="noopener noreferrer"
										title={`WhatsApp ${member.name}`}
										aria-label={`WhatsApp ${member.name}`}
									>
										<span class="sr-only">WhatsApp</span>
										<IconWhatsApp class="text-gray-500 hover:text-emerald-600 hover:bg-gray-200 transition bg-gray-100 p-2.5 size-11 rounded-full" />
									</a>
								</li>
							)}
							{member.email && (
								<li>
									<a
										href={`mailto:${member.email}`}
										title={`Email ${member.name}`}
										aria-label={`Email ${member.name}`}
									>
										<span class="sr-only">Email</span>
										<IconMail class="text-gray-500 hover:text-red-700 hover:bg-gray-200 transition bg-gray-100 p-2.5 size-11 rounded-full" />
									</a>
								</li>
							)}
						</ul>
					)}
				</li>
			);
		})
	}
</ul>
