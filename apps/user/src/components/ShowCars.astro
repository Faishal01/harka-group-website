---
import type { ShowCarsProps as Props } from "~/types";
import CardCarAlt from "~/components/car/CardCarAlt.astro";
import CardCar from "~/components/car/CardCar.astro";
import { getDb, cars as carsTable } from "@harka/db";
import { inArray, desc, isNull, and, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";

const { recent = false, featured = false, slugs = [], ui = "list" } = Astro.props;
const db = getDb(env);

let dbCars = [];

if (recent) {
	dbCars = await db
		.select()
		.from(carsTable)
		.where(and(isNull(carsTable.deletedAt), eq(carsTable.hidden, false)))
		.orderBy(desc(carsTable.publishDate))
		.limit(3);
} else if (featured) {
	dbCars = await db
		.select()
		.from(carsTable)
		.where(
			and(isNull(carsTable.deletedAt), eq(carsTable.featured, true), eq(carsTable.hidden, false)),
		)
		.orderBy(desc(carsTable.publishDate))
		.limit(3);
} else if (slugs.length > 0) {
	dbCars = await db
		.select()
		.from(carsTable)
		.where(
			and(inArray(carsTable.id, slugs), isNull(carsTable.deletedAt), eq(carsTable.hidden, false)),
		);
} else {
	return;
}

const cars = dbCars;

const wrapperClasses = {
	list: "grid grid-cols-1 gap-8",
	grid: "grid grid-cols-1 gap-8 lg:grid-cols-3",
};
---

<ul class={wrapperClasses[ui]}>
	{cars.map((car) => (ui === "grid" ? <CardCarAlt car={car} /> : <CardCar car={car} />))}
</ul>
