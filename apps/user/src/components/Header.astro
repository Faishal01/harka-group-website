---
import { menuMain, menuMobile } from "~/data/menus";
import icon from "~/assets/images/icons/logo.png";
import { Image } from "astro:assets";
const rmTrailingSlash = (path: string): string => {
	return path.endsWith("/") && path.length > 1 ? path.slice(0, path.length - 1) : path;
};

const pathname = rmTrailingSlash(Astro.url.pathname);
---

<header>
	<section class="bg-linear-to-b from-red-900 to-red-600 text-white relative z-40">
		<div class="container py-4 lg:py-8">
			<div class="flex justify-between items-center gap-x-4">
				<a
					href="/"
					class="focus:outline-none focus-visible:ring-2 focus-visible:ring-white rounded-lg"
				>
					<div class="flex items-center gap-x-2">
						<Image
							src={icon}
							class="h-14 lg:h-16 w-auto inline-block object-contain"
							alt="Harka Autocar Logo"
						/>
						<span class="font-bold text-2xl lg:text-4xl font-header">
							Harka<span class="font-normal">Autocar</span>
						</span>
					</div>
				</a>

				<!-- Desktop Navigation -->
				<nav class="max-lg:hidden" role="navigation" aria-label="Main Navigation">
					<div class="flex lg:gap-x-10 items-center">
						{
							menuMain.map((item, index) => {
								const hasSubmenu = Boolean(item.submenu && item.submenu.length > 0);
								const isSubmenuActive =
									hasSubmenu &&
									item.submenu?.some(
										(sub) =>
											pathname === sub.url ||
											(sub.url && sub.url !== "/" && pathname.startsWith(sub.url)),
									);
								const isDirectActive =
									pathname === item.url ||
									(item.url && item.url !== "/" && pathname.startsWith(item.url));
								const isActive = isDirectActive || isSubmenuActive;

								return (
									<div class="relative group">
										{hasSubmenu ? (
											<button
												type="button"
												class={`flex items-center gap-x-1.5 py-1 border-b-2 transition border-transparent hover:border-white font-medium cursor-pointer ${
													isActive ? "font-bold border-white" : ""
												}`}
												aria-haspopup="true"
												aria-expanded="false"
											>
												<span>{item.label}</span>
												<svg
													xmlns="http://www.w3.org/2000/svg"
													class="size-4 transition-transform duration-200 group-hover:rotate-180 opacity-80 group-hover:opacity-100"
													viewBox="0 0 20 20"
													fill="currentColor"
												>
													<path
														fill-rule="evenodd"
														d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
														clip-rule="evenodd"
													/>
												</svg>
											</button>
										) : (
											<a
												href={item.url}
												class={`block py-1 border-b-2 transition border-transparent ${
													isActive ? "font-bold border-white" : "hover:border-white font-medium"
												}`}
											>
												{item.label}
											</a>
										)}

										{hasSubmenu && item.submenu && (
											<div
												class={`absolute top-full -mt-1 pt-3 z-50 translate-y-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 ${
													index === menuMain.length - 1 ? "right-0" : "-left-3"
												}`}
												role="menu"
											>
												<div
													class="bg-white rounded-xl shadow-2xl ring-1 ring-black/10 overflow-hidden py-1.5 text-gray-800 backdrop-blur-md"
													role="menu"
													aria-label={`Submenu for ${item.label}`}
												>
													{item.submenu.map((subItem) => {
														const isCurrent = pathname === subItem.url;
														return (
															<a
																href={subItem.url}
																class={`flex items-center justify-between px-4 py-3 text-sm transition group/sub ${
																	isCurrent
																		? "bg-red-50 text-red-700 font-bold"
																		: "text-gray-700 hover:bg-gray-100 hover:text-red-700 font-medium"
																}`}
																role="menuitem"
															>
																<span>{subItem.label}</span>
																<svg
																	xmlns="http://www.w3.org/2000/svg"
																	class={`size-4 text-gray-400 group-hover/sub:text-red-600 group-hover/sub:translate-x-0.5 transition-all ${
																		isCurrent ? "text-red-600" : ""
																	}`}
																	viewBox="0 0 20 20"
																	fill="currentColor"
																>
																	<path
																		fill-rule="evenodd"
																		d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
																		clip-rule="evenodd"
																	/>
																</svg>
															</a>
														);
													})}
												</div>
											</div>
										)}
									</div>
								);
							})
						}
					</div>
				</nav>

				<!-- Mobile Menu Toggle Button -->
				<button
					id="mobile-menu-toggle"
					type="button"
					class="lg:hidden p-2.5 -mr-2 text-white hover:bg-red-800/80 rounded-xl transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/40"
					aria-label="Buka menu navigasi"
					aria-expanded="false"
					aria-controls="mobile-drawer-panel"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.75"
						stroke="currentColor"
						class="size-6"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
					</svg>
				</button>
			</div>
		</div>
	</section>

	<!-- MOBILE OFF-CANVAS DRAWER -->
	<!-- Backdrop Overlay -->
	<div
		id="mobile-drawer-backdrop"
		class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300"
		aria-hidden="true"
	>
	</div>

	<!-- Drawer Slide Panel -->
	<div
		id="mobile-drawer-panel"
		class="fixed inset-y-0 right-0 w-80 max-w-[85vw] bg-gray-950 text-white z-50 shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out"
		role="dialog"
		aria-modal="true"
		aria-label="Menu Navigasi Mobile"
	>
		<!-- Drawer Header -->
		<div class="p-5 flex items-center justify-between border-b border-gray-800 shrink-0">
			<div class="flex items-center gap-2">
				<Image src={icon} class="h-9 w-auto inline-block object-contain" alt="Harka Autocar Logo" />
				<span class="font-bold text-lg font-header text-white tracking-wide">
					Harka<span class="font-normal text-red-500">Autocar</span>
				</span>
			</div>
			<button
				id="mobile-drawer-close"
				type="button"
				class="p-2 rounded-xl text-gray-400 hover:text-white hover:bg-gray-800 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-600"
				aria-label="Tutup menu"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="size-5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		<!-- Drawer Navigation List -->
		<nav
			class="p-4 space-y-1.5 grow overflow-y-auto"
			role="navigation"
			aria-label="Mobile Navigation"
		>
			{
				menuMobile.map((item) => {
					const isActive =
						pathname === item.url || (item.url !== "/" && pathname.startsWith(item.url));

					return (
						<a
							href={item.url}
							class={`mobile-drawer-link group flex items-center gap-3.5 p-3 rounded-xl transition ${
								isActive
									? "bg-red-950/60 border border-red-600/40 text-white"
									: "text-gray-300 hover:bg-gray-900 hover:text-white border border-transparent"
							}`}
						>
							{/* Icon Badge */}
							<div
								class={`size-10 rounded-xl flex items-center justify-center shrink-0 transition ${
									isActive
										? "bg-red-700 text-white shadow-md shadow-red-900/50"
										: "bg-gray-900 border border-gray-800 text-red-500 group-hover:bg-red-950/40 group-hover:border-red-600/40"
								}`}
							>
								{item.icon === "home" && (
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
										<polyline points="9 22 9 12 15 12 15 22" />
									</svg>
								)}
								{item.icon === "trade" && (
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<path d="M17 2l4 4-4 4" />
										<path d="M3 11v-1a4 4 0 0 1 4-4h14" />
										<path d="M7 22l-4-4 4-4" />
										<path d="M21 13v1a4 4 0 0 1-4 4H3" />
									</svg>
								)}
								{item.icon === "sell" && (
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<line x1="12" y1="1" x2="12" y2="23" />
										<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
									</svg>
								)}
								{item.icon === "team" && (
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
										<circle cx="9" cy="7" r="4" />
										<path d="M23 21v-2a4 4 0 0 0-3-3.87" />
										<path d="M16 3.13a4 4 0 0 1 0 7.75" />
									</svg>
								)}
								{item.icon === "contact" && (
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
									</svg>
								)}
							</div>

							{/* Labels */}
							<div class="grow min-w-0">
								<div
									class={`text-sm font-bold ${isActive ? "text-white" : "text-gray-200 group-hover:text-white"}`}
								>
									{item.label}
								</div>
								{item.description && (
									<div class="text-[11px] text-gray-400 group-hover:text-gray-300 truncate">
										{item.description}
									</div>
								)}
							</div>

							{/* Arrow Indicator */}
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class={`size-4 text-gray-500 group-hover:text-red-400 group-hover:translate-x-0.5 transition-all shrink-0 ${
									isActive ? "text-red-400" : ""
								}`}
								viewBox="0 0 20 20"
								fill="currentColor"
							>
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								/>
							</svg>
						</a>
					);
				})
			}
		</nav>

		<!-- Drawer Footer with WhatsApp Action -->
		<div class="p-4 border-t border-gray-800 bg-gray-900/60 shrink-0 space-y-3">
			<a
				href="https://wa.me/6281276858079?text=Halo%20Harka%20Autocar,%20saya%20ingin%20bertanya%20mengenai%20unit%20mobil..."
				target="_blank"
				rel="noopener noreferrer"
				class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold text-sm shadow-lg shadow-emerald-950/40 transition"
			>
				<svg class="size-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
					<path
						d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"
					></path>
				</svg>
				<span>Chat WhatsApp</span>
			</a>
			<div class="text-center text-[11px] text-gray-400">
				📍 Jl. Prof. Dr. Hamka, Padang Panjang
			</div>
		</div>
	</div>
</header>

<script>
	function setupMobileDrawer() {
		const toggleBtn = document.getElementById("mobile-menu-toggle");
		const closeBtn = document.getElementById("mobile-drawer-close");
		const backdrop = document.getElementById("mobile-drawer-backdrop");
		const panel = document.getElementById("mobile-drawer-panel");
		const navLinks = document.querySelectorAll(".mobile-drawer-link");

		if (!toggleBtn || !backdrop || !panel) return;

		const openDrawer = () => {
			backdrop.classList.remove("pointer-events-none");
			backdrop.classList.remove("opacity-0");
			backdrop.classList.add("opacity-100");

			panel.classList.remove("translate-x-full");
			panel.classList.add("translate-x-0");

			toggleBtn.setAttribute("aria-expanded", "true");
			document.body.classList.add("overflow-hidden");
		};

		const closeDrawer = () => {
			backdrop.classList.add("opacity-0");
			backdrop.classList.remove("opacity-100");
			backdrop.classList.add("pointer-events-none");

			panel.classList.add("translate-x-full");
			panel.classList.remove("translate-x-0");

			toggleBtn.setAttribute("aria-expanded", "false");
			document.body.classList.remove("overflow-hidden");
		};

		toggleBtn.onclick = openDrawer;
		if (closeBtn) closeBtn.onclick = closeDrawer;
		backdrop.onclick = closeDrawer;

		navLinks.forEach((link) => {
			link.addEventListener("click", closeDrawer);
		});

		window.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !panel.classList.contains("translate-x-full")) {
				closeDrawer();
			}
		});
	}

	document.addEventListener("astro:page-load", setupMobileDrawer);
</script>
