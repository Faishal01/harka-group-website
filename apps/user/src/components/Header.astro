---
import { menuMain } from "~/data/menus";
import icon from "~/assets/images/icons/logo.png";
import { Image } from "astro:assets";
const rmTrailingSlash = (path: string): string => {
	return path.endsWith("/") && path.length > 1 ? path.slice(0, path.length - 1) : path;
};

const pathname = rmTrailingSlash(Astro.url.pathname);
---

<header>
	<section class="bg-red-700 text-white">
		<div class="container py-4 lg:py-8">
			<div class="flex justify-between items-center gap-x-4">
				<a href="/">
					<div class="flex items-center gap-x-2">
						<!-- <icon class="h-5 lg:h-8 inline-block"></icon> -->
						<Image src={icon} class="h-16 w-28 inline-block" alt={""} />
						<span class="font-bold text-2xl lg:text-4xl"
							>Harka <span class="font-normal">Group</span></span
						>
					</div>
				</a>

				<nav class="max-lg:hidden" role="navigation" aria-label="Main Navigation">
					<div class="flex lg:gap-x-12 items-center">
						{
							menuMain.map((item, index) => (
								<div class="relative group">
									{item.submenu ? (
										<button
											type="button"
											class={`flex items-center gap-x-1 border-b-2 transition border-transparent hover:border-white font-medium ${pathname === item.url || (item.url && item.url !== "/" && pathname.startsWith(item.url)) ? "font-bold" : ""}`}
											aria-haspopup="true"
											aria-expanded="false"
										>
											{item.label}
											<svg
												xmlns="http://www.w3.org/2000/svg"
												class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
												viewBox="0 0 20 20"
												fill="currentColor"
											>
												<path
													fill-rule="evenodd"
													d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
													clip-rule="evenodd"
												/>
											</svg>
										</button>
									) : (
										<a
											href={item.url}
											class={`block border-b-2 transition border-transparent ${pathname === item.url ? "font-bold" : "hover:border-white font-medium"}`}
										>
											{item.label}
										</a>
									)}
									{item.submenu && (
										<div
											class={`absolute top-full -mt-2 pt-4 z-50 translate-y-2 w-screen max-w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300 ${index === menuMain.length - 1 ? "right-0" : "-left-4"}`}
											role="menu"
										>
											<div
												class="bg-white rounded-lg ring-1 shadow-md ring-gray-900/5 overflow-hidden text-gray-800"
												role="menu"
												aria-label={`Submenu for ${item.label}`}
											>
												{item.submenu.map((subItem) => (
													<a
														href={subItem.url}
														class={`block px-4 py-3 text-base hover:bg-gray-100 focus:bg-gray-100 focus:outline-none ${
															pathname === subItem.url ? "font-bold" : "font-medium"
														}`}
														role="menuitem"
													>
														{subItem.label}
													</a>
												))}
											</div>
										</div>
									)}
								</div>
							))
						}
					</div>
				</nav>

				<!-- Mobile Menu Toggle Button -->
				<button
					id="mobile-menu-toggle"
					type="button"
					class="lg:hidden p-2 -mr-2 text-white focus:outline-none"
					aria-label="Toggle mobile menu"
					aria-expanded="false"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						class="w-6 h-6"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Mobile Menu Overlay/Container -->
		<div id="mobile-menu" class="hidden lg:hidden bg-red-800 text-white px-4 pt-2 pb-6 space-y-2">
			{
				menuMain.map((item) => (
					<div>
						{item.submenu ? (
							<div>
								<button
									type="button"
									class="mobile-accordion-toggle flex w-full items-center justify-between py-3 text-lg font-medium border-b border-red-700/50"
									aria-expanded="false"
								>
									{item.label}
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-5 h-5 transition-transform duration-200 chevron"
										viewBox="0 0 20 20"
										fill="currentColor"
									>
										<path
											fill-rule="evenodd"
											d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
											clip-rule="evenodd"
										/>
									</svg>
								</button>
								<div class="mobile-submenu hidden flex-col pl-4 pt-2 pb-2 space-y-3 bg-red-800/50 rounded-b">
									{item.submenu.map((subItem) => (
										<a
											href={subItem.url}
											class={`block text-base ${pathname === subItem.url ? "font-bold" : "font-medium text-gray-200"}`}
										>
											{subItem.label}
										</a>
									))}
								</div>
							</div>
						) : (
							<a
								href={item.url}
								class={`block py-3 text-lg border-b border-red-700/50 ${pathname === item.url ? "font-bold" : "font-medium"}`}
							>
								{item.label}
							</a>
						)}
					</div>
				))
			}
		</div>
	</section>
</header>

<script>
	const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
	const mobileMenu = document.getElementById("mobile-menu");

	if (mobileMenuToggle && mobileMenu) {
		mobileMenuToggle.addEventListener("click", () => {
			const isExpanded = mobileMenuToggle.getAttribute("aria-expanded") === "true";
			mobileMenuToggle.setAttribute("aria-expanded", !isExpanded ? "true" : "false");
			mobileMenu.classList.toggle("hidden");
		});
	}

	const accordions = document.querySelectorAll(".mobile-accordion-toggle");
	accordions.forEach((btn) => {
		btn.addEventListener("click", () => {
			const isExpanded = btn.getAttribute("aria-expanded") === "true";
			btn.setAttribute("aria-expanded", !isExpanded ? "true" : "false");

			const submenu = btn.nextElementSibling;
			if (submenu) {
				submenu.classList.toggle("hidden");
				submenu.classList.toggle("flex");
			}

			const chevron = btn.querySelector(".chevron");
			if (chevron) {
				chevron.classList.toggle("rotate-180");
			}
		});
	});
</script>
