---
import { siteName } from "~/data/config";
import { menuNavigation, menuMisc } from "~/data/menus";
import icon from "~/assets/images/icons/logo.png";
import SocialMediaIcons from "./SocialMediaIcons.astro";
import { Image } from "astro:assets";
const year = new Date().getFullYear();

// Combine all menu items into one array for the horizontal list
const allLinks = [...menuNavigation.items, ...menuMisc.items];
---

<footer class="bg-gray-50 border-t border-gray-200">
	<div class="container py-12 flex flex-col items-center text-center">
		<!-- Logo -->
		<a href="/" class="mb-8">
			<div class="flex items-center gap-x-2">
				<Image src={icon} class="h-16 w-28 inline-block" alt={""} />
				<span class="font-bold text-2xl lg:text-4xl"
					>Harka <span class="font-normal">Group</span></span
				>
			</div>
		</a>

		<!-- Navigation Links -->
		<nav class="mb-8 w-full">
			<ul class="flex flex-wrap justify-center gap-x-8 gap-y-4">
				{
					allLinks.map((item) => (
						<li>
							<a
								href={item.url}
								class="text-base font-medium text-gray-600 hover:text-gray-900 transition"
							>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!-- Social Media -->
		<div class="mb-8 flex justify-center gap-6">
			<SocialMediaIcons />
		</div>

		<!-- Copyright -->
		<p class="text-sm text-gray-500">
			<span>&copy; {year} </span>
			{siteName}. All rights reserved.
		</p>
	</div>
</footer>
