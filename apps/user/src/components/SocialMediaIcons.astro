---
import { socialMedia } from "~/data/config.js";
---

<Fragment>
	{
		Object.values(socialMedia).map((item: { url: string; label: string; icon: string }) => (
			<a
				href={item.url}
				target="_blank"
				aria-label={item.label}
				rel="noopener noreferrer"
				class="social-media-icon text-gray-600 hover:text-gray-800 transition"
			>
				<iconify-icon icon={item.icon} class="size-8 p-1" inline />
			</a>
		))
	}
	<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
</Fragment>
