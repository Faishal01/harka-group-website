---
import type { Car } from "~/types";
import { getMileage, getMileageUnit } from "~/utils/helpers";
import { fuelTypeMap, transmissionMap, ownershipStatusMap } from "~/data/constants";
import { viewPage } from "~/data/captions";

interface Props {
	car: Car;
}

const { car } = Astro.props;

if (!car) {
	return;
}

const mileage = `${getMileage(car.mileage)} ${getMileageUnit()}`;
const ownershipLabel = car.ownershipStatus
	? ownershipStatusMap[car.ownershipStatus] || car.ownershipStatus
	: "-";

const taxFormatted = car.taxExpirationDate
	? new Date(car.taxExpirationDate) >= new Date()
		? `Hidup (s/d ${new Date(car.taxExpirationDate).toLocaleDateString("id-ID", { month: "long", year: "numeric" })})`
		: `Mati (${new Date(car.taxExpirationDate).toLocaleDateString("id-ID", { month: "long", year: "numeric" })})`
	: "-";

interface FeatureItem {
	label: string;
	value: string | number | null | undefined;
	badge?: "safe" | "warn";
}

const sections: { title: string; items: FeatureItem[] }[] = [
	{
		title: "Spesifikasi Kendaraan",
		items: [
			{ label: "Merek", value: car.make },
			{ label: "Model", value: car.model },
			{ label: "Tahun", value: car.year },
			{ label: "Jarak Tempuh", value: mileage },
			{ label: "Tipe Body", value: car.bodyType },
			{ label: "Transmisi", value: transmissionMap[car.transmission] || car.transmission },
			{ label: "Bahan Bakar", value: fuelTypeMap[car.fuelType] || car.fuelType },
			{ label: "Warna", value: car.color },
			{
				label: viewPage.seatingCapacity,
				value: car.seatingCapacity ? `${car.seatingCapacity} Penumpang` : null,
			},
		].filter((i) => i.value !== null && i.value !== undefined && i.value !== ""),
	},
	{
		title: "Performa & Mesin",
		items: [
			{
				label: "Tenaga",
				value: car.horsePower ? `${car.horsePower} PS` : null,
			},
			{
				label: "Kapasitas Mesin",
				value: car.engineSizeCC ? `${car.engineSizeCC} cc` : null,
			},
		].filter((i) => i.value !== null && i.value !== undefined && i.value !== ""),
	},
	{
		title: "Riwayat & Legalitas",
		items: [
			{
				label: viewPage.ownershipStatus,
				value: ownershipLabel,
			},
			{
				label: viewPage.plateNumber,
				value: car.plateNumber || null,
			},
			{
				label: viewPage.taxStatus,
				value: taxFormatted,
			},
			{
				label: viewPage.floodHistory,
				value: car.isFloodFree ? "Bebas Banjir" : "Pernah Terendam",
				badge: (car.isFloodFree ? "safe" : "warn") as "safe" | "warn",
			},
			{
				label: viewPage.accidentHistory,
				value: car.isAccidentFree ? "Bebas Tabrak" : "Ada Riwayat",
				badge: (car.isAccidentFree ? "safe" : "warn") as "safe" | "warn",
			},
		].filter((i) => i.value !== null && i.value !== undefined && i.value !== ""),
	},
].filter((s) => s.items.length > 0);
---

<div class="space-y-8">
	{
		sections.map((section) => (
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-8 items-start">
				<h2 class="text-base sm:text-lg font-bold text-gray-900 font-header flex items-center gap-2">
					<span class="inline-block w-1 h-5 rounded-full bg-red-600" />
					<span>{section.title}</span>
				</h2>

				<dl class="lg:col-span-2 rounded-xl border border-gray-200/80 bg-gray-50/60 divide-y divide-gray-200/70 px-4">
					{section.items.map((item) => (
						<div class="py-3 flex items-center justify-between gap-4 text-sm">
							<dt class="text-gray-500">{item.label}</dt>
							<dd class="font-semibold text-gray-900 text-right">
								{item.badge === "safe" ? (
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/70 text-xs font-semibold">
										{item.value}
									</span>
								) : item.badge === "warn" ? (
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200/70 text-xs font-semibold">
										{item.value}
									</span>
								) : (
									item.value
								)}
							</dd>
						</div>
					))}
				</dl>
			</div>
		))
	}
</div>
