---
import type { Car } from "~/types";
import { getMileage, getMileageUnit } from "~/utils/helpers";
import { viewPage } from "~/data/captions";
import IconFuel from "~/assets/images/icons/fuel.svg";
import IconTransmission from "~/assets/images/icons/transmission.svg";
import IconMilage from "~/assets/images/icons/milage.svg";
import IconCalendar from "~/assets/images/icons/calendar.svg";
import IconOdometer from "~/assets/images/icons/odometer.svg";
import IconColor from "~/assets/images/icons/color.svg";
import { fuelTypeMap, transmissionMap, ownershipStatusMap } from "~/data/constants";

interface Props {
	car: Car;
}

const { car } = Astro.props;

const rawMileage = car.mileage ?? 0;
const mileage = getMileage(rawMileage);
const mileageUnit = getMileageUnit();
const ownershipLabel = car.ownershipStatus
	? ownershipStatusMap[car.ownershipStatus] || car.ownershipStatus
	: null;
---

<div class="rounded-xl bg-gray-50 border border-gray-200/80 w-full p-4 my-6">
	<dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 gap-x-4 gap-y-3.5">
		<div class="flex items-start gap-2.5">
			<IconFuel class="size-4 mt-0.5 text-gray-500 shrink-0" />
			<div class="min-w-0">
				<dt class="text-xs text-gray-500">Bahan Bakar</dt>
				<dd class="text-sm font-semibold text-gray-900 truncate">
					{fuelTypeMap[car.fuelType] || car.fuelType}
				</dd>
			</div>
		</div>

		<div class="flex items-start gap-2.5">
			<IconTransmission class="size-4 mt-0.5 text-gray-500 shrink-0" />
			<div class="min-w-0">
				<dt class="text-xs text-gray-500">Transmisi</dt>
				<dd class="text-sm font-semibold text-gray-900 truncate">
					{transmissionMap[car.transmission] || car.transmission}
				</dd>
			</div>
		</div>

		<div class="flex items-start gap-2.5">
			<IconMilage class="size-4 mt-0.5 text-gray-500 shrink-0" />
			<div class="min-w-0">
				<dt class="text-xs text-gray-500">Jarak Tempuh</dt>
				<dd class="text-sm font-semibold text-gray-900 truncate">{`${mileage} ${mileageUnit}`}</dd>
			</div>
		</div>

		<div class="flex items-start gap-2.5">
			<IconCalendar class="size-4 mt-0.5 text-gray-500 shrink-0" />
			<div class="min-w-0">
				<dt class="text-xs text-gray-500">Tahun</dt>
				<dd class="text-sm font-semibold text-gray-900 truncate">{car.year}</dd>
			</div>
		</div>

		{
			ownershipLabel && (
				<div class="flex items-start gap-2.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-4 mt-0.5 text-gray-500 shrink-0"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
						/>
					</svg>
					<div class="min-w-0">
						<dt class="text-xs text-gray-500">{viewPage.ownershipStatus}</dt>
						<dd class="text-sm font-semibold text-gray-900 truncate">{ownershipLabel}</dd>
					</div>
				</div>
			)
		}

		<div class="flex items-start gap-2.5">
			<IconColor class="size-4 mt-0.5 text-gray-500 shrink-0" />
			<div class="min-w-0">
				<dt class="text-xs text-gray-500">Warna</dt>
				<dd class="text-sm font-semibold text-gray-900 truncate">{car.color}</dd>
			</div>
		</div>

		{
			car.horsePower ? (
				<div class="flex items-start gap-2.5">
					<IconOdometer class="size-4 mt-0.5 text-gray-500 shrink-0" />
					<div class="min-w-0">
						<dt class="text-xs text-gray-500">Tenaga</dt>
						<dd class="text-sm font-semibold text-gray-900 truncate">
							{car.horsePower} {viewPage.bhp}
						</dd>
					</div>
				</div>
			) : null
		}
	</dl>
</div>
