---
import type { Car } from "~/types";
import { getMileage, getMileageUnit } from "~/utils/helpers";
import { viewPage } from "~/data/captions";
import IconFuel from "~/assets/images/icons/fuel.svg";
import IconTransmission from "~/assets/images/icons/transmission.svg";
import IconMilage from "~/assets/images/icons/milage.svg";
import IconCalendar from "~/assets/images/icons/calendar.svg";
import IconOdometer from "~/assets/images/icons/odometer.svg";
import IconColor from "~/assets/images/icons/color.svg";
import { fuelTypeMap, transmissionMap, ownershipStatusMap } from "~/data/constants";

interface Props {
	car: Car;
}

const { car } = Astro.props;

const rawMileage = car.mileage ?? 0;
const mileage = getMileage(rawMileage);
const mileageUnit = getMileageUnit();
const ownershipLabel = car.ownershipStatus
	? ownershipStatusMap[car.ownershipStatus] || car.ownershipStatus
	: null;
---

<div class="rounded-md ring-1 ring-gray-800 w-full p-4 my-8 text-base">
	<dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-4">
		<div class="flex items-start gap-x-2">
			<IconFuel class="size-5 mt-0.5" />
			<div>
				<dt class="flex items-center text-gray-500">Jenis Bahan Bakar</dt>
				<dd class="font-semibold">
					{fuelTypeMap[car.fuelType] || car.fuelType}
				</dd>
			</div>
		</div>

		<div class="flex items-start gap-x-2">
			<IconTransmission class="size-5 mt-0.5" />
			<div>
				<dt class="flex items-center text-gray-500">Transmisi</dt>
				<dd class="font-semibold">
					{transmissionMap[car.transmission] || car.transmission}
				</dd>
			</div>
		</div>

		<div class="flex items-start gap-x-2">
			<IconMilage class="size-5 mt-0.5" />
			<div>
				<dt class="flex items-center text-gray-500">Jarak Tempuh</dt>
				<dd class="font-semibold">
					{`${mileage} ${mileageUnit}`}
				</dd>
			</div>
		</div>

		<div class="flex items-start gap-x-2">
			<IconCalendar class="size-5 mt-0.5" />
			<div>
				<dt class="flex items-center text-gray-500">Tahun</dt>
				<dd class="font-semibold">
					{car.year}
				</dd>
			</div>
		</div>

		{
			ownershipLabel && (
				<div class="flex items-start gap-x-2">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-5 mt-0.5 text-gray-700"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
						/>
					</svg>
					<div>
						<dt class="flex items-center text-gray-500">{viewPage.ownershipStatus}</dt>
						<dd class="font-semibold text-blue-700">{ownershipLabel}</dd>
					</div>
				</div>
			)
		}

		<div class="flex items-start gap-x-2">
			<IconColor class="size-5 mt-0.5" />
			<div>
				<dt class="flex items-center text-gray-500">Warna</dt>
				<dd class="font-semibold">
					{car.color}
				</dd>
			</div>
		</div>

		{
			car.horsePower ? (
				<div class="flex items-start gap-x-2">
					<IconOdometer class="size-5 mt-0.5" />
					<div>
						<dt class="flex items-center text-gray-500">Tenaga</dt>
						<dd class="font-semibold">
							{car.horsePower} {viewPage.bhp}
						</dd>
					</div>
				</div>
			) : null
		}
	</dl>
</div>
