---
import { getPrice } from "~/utils/helpers";

interface Props {
	price?: number;
	promoPrice?: number | null;
	properties?: { price: number; promoPrice?: number | null };
}

const { price: propPrice, promoPrice: propPromoPrice, properties } = Astro.props;
const rawPrice = propPrice ?? properties?.price ?? 0;
const rawPromoPrice = propPromoPrice !== undefined ? propPromoPrice : properties?.promoPrice;
const isPromo = rawPromoPrice && rawPromoPrice < rawPrice;
---

<div id="single-page-price-wrapper" class="mt-4 flex items-baseline gap-2.5 flex-wrap">
	{
		isPromo ? (
			<>
				<span class="price font-bold text-2xl sm:text-3xl text-red-700 tracking-tight font-inter">
					{getPrice(rawPromoPrice!)}
				</span>
				<span class="text-sm sm:text-base text-gray-400 line-through font-medium">
					{getPrice(rawPrice)}
				</span>
				<span class="inline-flex items-center px-2 py-0.5 rounded-full bg-red-50 text-red-700 border border-red-200 text-[11px] font-bold uppercase tracking-wide">
					Promo
				</span>
			</>
		) : (
			<span class="price font-bold text-2xl sm:text-3xl text-gray-900 tracking-tight font-inter">
				{getPrice(rawPrice)}
			</span>
		)
	}
</div>
