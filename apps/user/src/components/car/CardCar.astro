---
import type { Car } from "~/types";

import CarHighlights from "~/components/car/CardHighlights.astro";
import CardPrice from "~/components/car/CardPrice.astro";
import IconLogo from "~/assets/images/icons/logo.svg";

interface Props {
	car: Car;
}

const { car } = Astro.props;
const isSold = car.archiveReason === "sold";
---

<li
	data-car-id={car.id}
	class="card-car bg-white shadow overflow-hidden xxl:transition xxl:border-transparent xxl:border-r-4 hover:lg:border-red-700"
>
	<a href={`/view/${car.id}`} class="relative isolate flex flex-col gap-8 xxl:flex-row">
		<div class="relative aspect-[4/3] xxl:w-72 lg:shrink-0 ribbon">
			{
				car.gallery?.[0]?.image ? (
					<img
						src={car.gallery[0].image}
						alt={car.gallery[0].alt || car.title}
						class="absolute inset-0 size-full bg-gray-50 object-cover"
					/>
				) : (
					<div class="absolute inset-0 text-gray-400 size-full bg-gray-100 flex flex-col gap-4 items-center justify-center">
						<IconLogo class="h-24" />
						<span class="text-gray-400 font-bold italic">Coming Soon</span>
					</div>
				)
			}
			{
				isSold && (
					<div class="absolute inset-0 bg-black/40 flex items-center justify-center backdrop-blur-[2px]">
						<span class="inline-block bg-red-600 text-white font-black text-2xl lg:text-3xl px-6 py-2 uppercase tracking-widest rounded shadow transform -skew-x-6 z-10 text-center border-2 border-white/90">
							SOLD
						</span>
					</div>
				)
			}
		</div>
		<div class="flex flex-col items-start lg:py-4 grow max-xxl:px-4 max-lg:pb-8">
			<div class="relative xxl:flex xxl:items-start xxl:gap-4 xxl:justify-between w-full">
				<div class="mb-4 lg:mb-6">
					<h2 class="h5 line-clamp-2">
						{car.title}
					</h2>
					{car.excerpt && <p class="text-base mt-2 line-clamp-3">{car.excerpt}</p>}
				</div>
				<CardPrice price={car.price} />
			</div>
			<div class="mt-auto lg:mb-4">
				<CarHighlights car={car} />
			</div>
		</div>
	</a>
</li>
