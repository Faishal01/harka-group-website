---
import { getPrice } from "~/utils/helpers";

interface Props {
	price?: number;
	data?: { price: number };
}

const { price: propPrice, data } = Astro.props;
const rawPrice = propPrice ?? data?.price ?? 0;
const formattedPrice = getPrice(rawPrice);
---

<div class="xxl:pr-8 shrink-0 max-xxl:flex max-xxl:gap-2 max-xxl:items-center max-xxl:mb-6">
	<span class="price font-semibold">
		{formattedPrice}
	</span>
</div>
