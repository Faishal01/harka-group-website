---
import IconPaperAirplane from "~/assets/images/icons/paper-airplane.svg";
import { inquireForm } from "~/data/captions";
---

<h2 class="h4">{inquireForm.title}</h2>
<p>{inquireForm.description}</p>
<form>
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
		<div>
			<label for="name">{inquireForm.name}</label>
			<input type="text" id="name" name="name" />
		</div>
		<div>
			<label for="email">{inquireForm.email}</label>
			<input type="email" id="email" name="email" />
		</div>
		<div class="lg:col-span-2">
			<label for="message">{inquireForm.message}</label>
			<textarea id="message" name="message" rows="4"></textarea>
		</div>
	</div>
	<div class="mt-8">
		<button type="submit" class="button button-primary gap-1">
			<IconPaperAirplane class="size-5 inline-block -mt-1 -rotate-45" />
			<span class="text-lg">{inquireForm.send}</span>
		</button>
	</div>
</form>
