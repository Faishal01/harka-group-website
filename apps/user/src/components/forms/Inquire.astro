---
import IconWhatsApp from "~/assets/images/icons/social-media/whatsapp.svg";
import { phone } from "~/data/config";
import { inquireForm } from "~/data/captions";
import { getPrice } from "~/utils/helpers";
import type { Car } from "~/types";

interface Props {
	car: Car;
	url?: string;
}

const { car, url = "" } = Astro.props;
const cleanPhone = phone.href.replace(/[^0-9]/g, "");
const vehicleTitle = `${car.year ? `${car.year} ` : ""}${car.make} ${car.model}`;
const isPromo = car.promoPrice && car.promoPrice < car.price;
const priceFormatted = isPromo ? `${getPrice(car.promoPrice!)} (Promo)` : getPrice(car.price);
---

<div class="mb-6">
	<h2 class="text-base sm:text-lg font-bold text-gray-900 font-header flex items-center gap-2">
		<span class="inline-block w-1 h-5 rounded-full bg-red-600"></span>
		<span>{inquireForm.title}</span>
	</h2>
	<p class="text-sm text-gray-600 mt-1.5">{inquireForm.description}</p>
</div>

<form
	id="inquire-form"
	data-phone={cleanPhone}
	data-car-title={vehicleTitle}
	data-car-price={priceFormatted}
	data-car-url={url}
	data-greeting={inquireForm.waGreeting}
>
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5">
		<div>
			<label for="inquire-name" class="block text-xs font-semibold text-gray-700 mb-1.5">
				{inquireForm.name}
			</label>
			<input
				type="text"
				id="inquire-name"
				name="name"
				required
				placeholder={inquireForm.namePlaceholder}
				autocomplete="name"
				class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-red-600 focus:ring-2 focus:ring-red-600/20 outline-none transition"
			/>
		</div>
		<div>
			<label for="inquire-phone" class="block text-xs font-semibold text-gray-700 mb-1.5">
				{inquireForm.phone}
			</label>
			<input
				type="tel"
				id="inquire-phone"
				name="phone"
				required
				placeholder={inquireForm.phonePlaceholder}
				autocomplete="tel"
				class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-red-600 focus:ring-2 focus:ring-red-600/20 outline-none transition"
			/>
		</div>
		<div class="lg:col-span-2">
			<label for="inquire-message" class="block text-xs font-semibold text-gray-700 mb-1.5">
				{inquireForm.message}
			</label>
			<textarea
				id="inquire-message"
				name="message"
				rows="4"
				required
				placeholder={inquireForm.messagePlaceholder}
				class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-red-600 focus:ring-2 focus:ring-red-600/20 outline-none transition"
			></textarea>
		</div>
	</div>
	<div class="mt-6">
		<button
			type="submit"
			class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold rounded-xl shadow-xs bg-emerald-600 hover:bg-emerald-700 text-white focus-visible:outline-emerald-600 gap-2 transition cursor-pointer"
		>
			<IconWhatsApp class="size-4 fill-current shrink-0" />
			<span>{inquireForm.send}</span>
		</button>
	</div>
</form>

<script>
	function setupInquireForm() {
		const form = document.getElementById("inquire-form") as HTMLFormElement | null;
		if (!form || form.dataset.initialized) return;
		form.dataset.initialized = "true";

		const cleanPhone = form.dataset.phone || "";
		const carTitle = form.dataset.carTitle || "";
		const carPrice = form.dataset.carPrice || "";
		const carUrl = form.dataset.carUrl || window.location.href;
		const waGreeting = form.dataset.greeting || "";

		form.addEventListener("submit", (e: SubmitEvent) => {
			e.preventDefault();
			const formData = new FormData(form);
			const name = (formData.get("name") || "").toString().trim();
			const userPhone = (formData.get("phone") || "").toString().trim();
			const userMessage = (formData.get("message") || "").toString().trim();

			if (!name || !userPhone || !userMessage) return;

			const messageLines = [
				waGreeting,
				`*Unit:* ${carTitle} (${carPrice})`,
				`*Link:* ${carUrl}`,
				"",
				`*Nama:* ${name}`,
				`*No. HP:* ${userPhone}`,
				`*Pesan:* ${userMessage}`,
			];

			const encodedText = encodeURIComponent(messageLines.join("\n"));
			const waUrl = `https://wa.me/${cleanPhone}?text=${encodedText}`;
			window.open(waUrl, "_blank", "noopener,noreferrer");
		});
	}

	document.addEventListener("astro:page-load", setupInquireForm);
	setupInquireForm();
</script>
