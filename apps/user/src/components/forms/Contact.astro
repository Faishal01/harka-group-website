---
import { phone } from "~/data/config";
import { contactForm } from "~/data/captions";
import IconWhatsApp from "~/assets/images/icons/social-media/whatsapp.svg";

const cleanPhone = phone.href.replace(/[^0-9]/g, "");
---

<form
	id="contact-form"
	class="space-y-4 sm:space-y-5"
	data-phone={cleanPhone}
	data-greeting={contactForm.waGreeting}
>
	<div>
		<label for="contact-name" class="block text-xs font-semibold text-gray-700 mb-1.5">
			{contactForm.name}
		</label>
		<input
			type="text"
			name="name"
			id="contact-name"
			required
			placeholder={contactForm.namePlaceholder}
			autocomplete="name"
			class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-red-600 focus:ring-2 focus:ring-red-600/20 outline-none transition"
		/>
	</div>

	<div>
		<label for="contact-phone" class="block text-xs font-semibold text-gray-700 mb-1.5">
			{contactForm.phone}
		</label>
		<input
			type="tel"
			name="phone"
			id="contact-phone"
			required
			placeholder={contactForm.phonePlaceholder}
			autocomplete="tel"
			class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-red-600 focus:ring-2 focus:ring-red-600/20 outline-none transition"
		/>
	</div>

	<div>
		<label for="contact-message" class="block text-xs font-semibold text-gray-700 mb-1.5">
			{contactForm.message}
		</label>
		<textarea
			name="message"
			id="contact-message"
			rows="4"
			required
			placeholder={contactForm.messagePlaceholder}
			class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-red-600 focus:ring-2 focus:ring-red-600/20 outline-none transition"
		></textarea>
	</div>

	<div class="pt-2 flex justify-end">
		<button
			type="submit"
			class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold rounded-xl shadow-xs bg-emerald-600 hover:bg-emerald-700 text-white focus-visible:outline-emerald-600 gap-2 transition cursor-pointer"
		>
			<IconWhatsApp class="size-4 fill-current shrink-0" />
			<span>{contactForm.sendWhatsApp}</span>
		</button>
	</div>
</form>

<script>
	function setupContactForm() {
		const form = document.getElementById("contact-form") as HTMLFormElement | null;
		if (!form || form.dataset.initialized) return;
		form.dataset.initialized = "true";

		const cleanPhone = form.dataset.phone || "";
		const waGreeting = form.dataset.greeting || "";

		form.addEventListener("submit", (e: SubmitEvent) => {
			e.preventDefault();
			const formData = new FormData(form);
			const name = (formData.get("name") || "").toString().trim();
			const userPhone = (formData.get("phone") || "").toString().trim();
			const userMessage = (formData.get("message") || "").toString().trim();

			if (!name || !userMessage) return;

			const messageLines = [
				waGreeting,
				"",
				`*Nama:* ${name}`,
				`*No. HP:* ${userPhone || "-"}`,
				`*Pesan:* ${userMessage}`,
			];

			const encodedText = encodeURIComponent(messageLines.join("\n"));
			const waUrl = `https://wa.me/${cleanPhone}?text=${encodedText}`;
			window.open(waUrl, "_blank", "noopener,noreferrer");
		});
	}

	document.addEventListener("astro:page-load", setupContactForm);
	setupContactForm();
</script>
