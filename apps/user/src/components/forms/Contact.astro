---
import { phone } from "~/data/config";
import { contactForm } from "~/data/captions";
import IconWhatsApp from "~/assets/images/icons/social-media/whatsapp.svg";

const cleanPhone = phone.href.replace(/[^0-9]/g, "");
---

<form
	id="contact-form"
	class="space-y-6"
	data-phone={cleanPhone}
	data-greeting={contactForm.waGreeting}
>
	<div>
		<label for="contact-name">
			{contactForm.name}
		</label>
		<input
			type="text"
			name="name"
			id="contact-name"
			required
			placeholder={contactForm.namePlaceholder}
			autocomplete="name"
		/>
	</div>

	<div>
		<label for="contact-phone">
			{contactForm.phone}
		</label>
		<input
			type="tel"
			name="phone"
			id="contact-phone"
			required
			placeholder={contactForm.phonePlaceholder}
			autocomplete="tel"
		/>
	</div>

	<div>
		<label for="contact-message">
			{contactForm.message}
		</label>
		<textarea
			name="message"
			id="contact-message"
			rows="4"
			required
			placeholder={contactForm.messagePlaceholder}></textarea>
	</div>

	<div class="pt-2 flex justify-end">
		<button
			type="submit"
			class="button button-primary gap-2 w-full sm:w-auto inline-flex items-center justify-center cursor-pointer"
		>
			<IconWhatsApp class="size-5 fill-current" />
			<span>{contactForm.sendWhatsApp}</span>
		</button>
	</div>
</form>

<script>
	function setupContactForm() {
		const form = document.getElementById("contact-form") as HTMLFormElement | null;
		if (!form || form.dataset.initialized) return;
		form.dataset.initialized = "true";

		const cleanPhone = form.dataset.phone || "";
		const waGreeting = form.dataset.greeting || "";

		form.addEventListener("submit", (e: SubmitEvent) => {
			e.preventDefault();
			const formData = new FormData(form);
			const name = (formData.get("name") || "").toString().trim();
			const userPhone = (formData.get("phone") || "").toString().trim();
			const userMessage = (formData.get("message") || "").toString().trim();

			if (!name || !userMessage) return;

			const messageLines = [
				waGreeting,
				"",
				`*Nama:* ${name}`,
				`*No. HP:* ${userPhone || "-"}`,
				`*Pesan:* ${userMessage}`,
			];

			const encodedText = encodeURIComponent(messageLines.join("\n"));
			const waUrl = `https://wa.me/${cleanPhone}?text=${encodedText}`;
			window.open(waUrl, "_blank", "noopener,noreferrer");
		});
	}

	document.addEventListener("astro:page-load", setupContactForm);
	setupContactForm();
</script>
