---
import IconSort from "~/assets/images/icons/sort.svg";
import { sortLabels } from "~/data/captions";
---

<form id="form-sort-mobile" class="max-lg:shrink-0">
	<div class="text-gray-800">
		<label class="sr-only" for="sort">Sort</label>
		<div class="grid grid-cols-1">
			<select
				name="sort"
				id="sort-mobile"
				class="appearance-none col-start-1 w-8 focus:outline-none row-start-1 outline-none bg-transparent"
				aria-label="Sort cars by"
			>
				<option value="all">{sortLabels.sortBy}</option>
				<option value="mileage-desc">{sortLabels.mileageDesc}</option>
				<option value="mileage-asc">{sortLabels.mileageAsc}</option>
				<option value="price-desc">{sortLabels.priceDesc}</option>
				<option value="price-asc">{sortLabels.priceAsc}</option>
				<option value="year-desc">{sortLabels.yearDesc}</option>
				<option value="year-asc">{sortLabels.yearAsc}</option>
			</select>
			<IconSort
				class="pointer-events-none text-white col-start-1 row-start-1 size-5 self-center justify-self-end"
			/>
		</div>
	</div>
</form>
