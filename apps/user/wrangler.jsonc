{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"name": "harka-group-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "5df8284982c14623b933f7efbf0b80b4",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "harka-db",
			"database_id": "cb6d4718-57ff-406c-b4d0-d6124fb40d7a",
		},
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "harka-images",
		},
	],
}
