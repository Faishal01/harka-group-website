---
export const prerender = false;

import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import VehicleInspectionCard from "~/components/admin/VehicleInspectionCard.astro";
import TradeInReviewActions from "~/components/admin/TradeInReviewActions.svelte";
import { createCore } from "@harka/core";
import { env } from "cloudflare:workers";
import { getPrice } from "~/utils/helpers";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/trade-in");
}

const core = createCore(env);
const sub = await core.tradeIn.getById(id).catch(() => null);

if (!sub) {
	return Astro.redirect("/trade-in");
}

let targetCar = null;
if (sub.targetCarId) {
	targetCar = await core.cars.getById(sub.targetCarId, { adminView: true }).catch(() => null);
}

const isSell = sub.submissionType === "sell_outright";
const serviceLabel = isSell ? "Jual Lepas" : "Tukar Tambah";

const formattedDate = new Date(sub.createdAt).toLocaleDateString("id-ID", {
	day: "numeric",
	month: "long",
	year: "numeric",
	hour: "2-digit",
	minute: "2-digit",
});

const cleanPhone = sub.customerPhone.replace(/[^0-9]/g, "");
const waText = isSell
	? `Halo Bapak/Ibu ${sub.customerName}, kami dari Harka Autocar menindaklanjuti pengajuan penjualan mobil untuk unit ${sub.year} ${sub.make} ${sub.model}. Apakah unit masih tersedia untuk dijadwalkan inspeksi fisik?`
	: `Halo Bapak/Ibu ${sub.customerName}, kami dari Harka Autocar menindaklanjuti pengajuan tukar tambah unit ${sub.year} ${sub.make} ${sub.model} dengan ${targetCar ? `${targetCar.year} ${targetCar.make} ${targetCar.model}` : "unit showroom kami"}. Apakah unit masih tersedia untuk dijadwalkan inspeksi fisik?`;

const waMessage = encodeURIComponent(waText);
const waUrl = `https://wa.me/${cleanPhone}?text=${waMessage}`;
---

<Layout pageTitle={`Inspeksi Unit ${serviceLabel}: ${sub.year} ${sub.make} ${sub.model}`}>
	<Section class="bg-gray-50 min-h-[85vh] py-8 sm:py-12">
		<Container>
			<!-- Top Navigation & Title -->
			<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
				<div>
					<a
						href="/trade-in"
						class="text-gray-500 hover:text-gray-700 transition flex items-center font-medium text-sm mb-2 w-fit"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4 mr-1"
							viewBox="0 0 20 20"
							fill="currentColor"
						>
							<path
								fill-rule="evenodd"
								d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
								clip-rule="evenodd"></path>
						</svg>
						Kembali ke Daftar Pengajuan
					</a>
					<div class="flex items-center gap-3">
						<h1 class="text-2xl sm:text-3xl font-bold text-gray-900">
							Lembar Inspeksi {serviceLabel}
						</h1>
						<span
							class={`px-3 py-1 text-xs font-bold rounded-full border ${
								isSell
									? "bg-teal-50 text-teal-800 border-teal-200"
									: "bg-indigo-50 text-indigo-800 border-indigo-200"
							}`}
						>
							{serviceLabel}
						</span>
					</div>
					<p class="text-xs sm:text-sm text-gray-500 mt-1">
						ID Referensi: <span class="font-mono font-bold text-gray-700">{sub.id}</span> &bull; Diajukan
						pada {formattedDate}
					</p>
				</div>

				<div>
					<a
						href={waUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-bold hover:bg-emerald-700 transition shadow-sm text-sm shrink-0"
					>
						<svg class="size-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path
								d="M17.472 14.382c-.301-.15-1.78-.879-2.056-.98-.276-.1-.477-.15-.678.15-.2.301-.778.98-.954 1.18-.175.201-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.895-.798-1.5-1.784-1.676-2.085-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.15-.175.2-.301.301-.502.1-.201.05-.376-.025-.527-.075-.15-.678-1.634-.929-2.237-.245-.588-.493-.508-.678-.517-.175-.01-.376-.01-.577-.01s-.527.075-.803.376c-.276.301-1.054 1.03-1.054 2.512s1.079 2.914 1.23 3.115c.15.201 2.124 3.243 5.145 4.549.719.311 1.281.497 1.719.636.723.23 1.381.197 1.901.12.579-.087 1.78-.728 2.031-1.431.251-.703.251-1.306.175-1.431-.075-.125-.276-.2-.577-.35zM12.042 21.908h-.008C10.288 21.907 8.57 21.436 7.07 20.543l-.507-.301-3.754.985 1.002-3.66-.33-.526C2.518 15.485 2 13.805 2 12.046c0-5.541 4.508-10.048 10.051-10.048 2.686 0 5.21 1.047 7.108 2.946 1.899 1.899 2.945 4.423 2.945 7.109 0 5.542-4.509 10.055-10.062 10.055z"
							></path>
						</svg>
						<span>Hubungi via WhatsApp</span>
					</a>
				</div>
			</div>

			<!-- Dedicated Review Action Banner Card -->
			<TradeInReviewActions
				client:load
				submissionId={sub.id}
				initialStatus={sub.status}
				initialReviewedAt={sub.reviewedAt ? sub.reviewedAt.toISOString() : null}
				initialReviewedBy={sub.reviewedBy}
				convertedCarId={sub.convertedCarId}
			/>

			<!-- Customer Profile Info Bar -->
			<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
				<h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">
					Informasi Kontak Pelanggan
				</h3>
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-sm">
					<div>
						<span class="text-gray-400 block text-xs">Nama Lengkap</span>
						<span class="font-bold text-gray-900">{sub.customerName}</span>
					</div>
					<div>
						<span class="text-gray-400 block text-xs">Nomor WhatsApp</span>
						<span class="font-bold text-gray-900">{sub.customerPhone}</span>
					</div>
					<div>
						<span class="text-gray-400 block text-xs">Kota Domisili</span>
						<span class="font-bold text-gray-900">{sub.customerCity}</span>
					</div>
					<div>
						<span class="text-gray-400 block text-xs">Email</span>
						<span class="font-medium text-gray-700">{sub.customerEmail || "-"}</span>
					</div>
				</div>
			</div>

			<!-- Target Unit Card (when Tukar Tambah) -->
			{
				sub.submissionType === "trade_in" && (
					<div class="bg-indigo-50/70 border border-indigo-200 rounded-2xl p-6 mb-8 shadow-xs">
						<div class="flex items-center justify-between mb-4">
							<div class="flex items-center gap-2">
								<span class="size-2.5 rounded-full bg-indigo-600" />
								<h3 class="text-xs sm:text-sm font-bold text-indigo-950 uppercase tracking-wider">
									Unit Tujuan Tukar Tambah (Pilihan Calon Pelanggan)
								</h3>
							</div>
							<span class="text-xs font-bold px-2.5 py-1 bg-indigo-100 text-indigo-800 rounded-full border border-indigo-200">
								Tukar Tambah
							</span>
						</div>

						{targetCar ? (
							<div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
								<div class="flex items-center gap-4 md:col-span-2">
									{targetCar.gallery?.[0]?.image ? (
										<img
											src={
												targetCar.gallery[0].image.startsWith("http") ||
												targetCar.gallery[0].image.startsWith("/api/images/")
													? targetCar.gallery[0].image
													: `/api/images/${targetCar.gallery[0].image}`
											}
											alt={targetCar.title}
											class="size-20 rounded-xl object-cover border border-indigo-200 shrink-0 bg-white"
										/>
									) : (
										<div class="size-20 rounded-xl bg-indigo-100 text-indigo-400 flex items-center justify-center shrink-0">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												class="size-8"
												fill="none"
												viewBox="0 0 24 24"
												stroke="currentColor"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="1.5"
													d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"
												/>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="1.5"
													d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"
												/>
											</svg>
										</div>
									)}
									<div>
										<h4 class="font-bold text-gray-900 text-base">
											{targetCar.year} {targetCar.make} {targetCar.model}
										</h4>
										<p class="text-xs text-gray-500 mt-0.5">
											{targetCar.mileage.toLocaleString("id-ID")} KM &bull; {targetCar.transmission}{" "}
											&bull; {targetCar.color}
										</p>
										<a
											href={`/cars/view/${targetCar.id}`}
											class="text-xs font-semibold text-indigo-700 hover:underline inline-flex items-center gap-1 mt-2"
										>
											<span>Lihat Detail Stok Mobil</span>
											<span>&rarr;</span>
										</a>
									</div>
								</div>

								<div class="bg-white rounded-xl p-4 border border-indigo-100 flex flex-col justify-between shadow-2xs">
									<div>
										<span class="text-xs text-gray-500 block">Harga Unit Showroom</span>
										<span class="font-bold text-gray-900 text-base">
											{getPrice(targetCar.price)}
										</span>
									</div>
									<div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between">
										<span class="text-xs text-indigo-950 font-semibold">
											Estimasi Selisih Bayar:
										</span>
										<span class="font-bold text-sm text-indigo-700">
											{getPrice(targetCar.price - sub.sellingPrice)}
										</span>
									</div>
								</div>
							</div>
						) : (
							<div class="text-sm text-gray-600 bg-white p-4 rounded-xl border border-indigo-100">
								ID Unit Pilihan: <span class="font-mono font-bold">{sub.targetCarId}</span>
								<p class="text-xs text-amber-700 mt-1">
									(Unit tujuan tidak ditemukan di inventaris aktif, kemungkinan telah terjual atau
									dihapus)
								</p>
							</div>
						)}
					</div>
				)
			}

			<!-- Reusable Vehicle Inspection Card -->
			<VehicleInspectionCard
				make={sub.make}
				model={sub.model}
				year={sub.year}
				mileage={sub.mileage}
				transmission={sub.transmission}
				fuelType={sub.fuelType}
				sellingPrice={sub.sellingPrice}
				plateNumber={sub.plateNumber}
				ownershipStatus={sub.ownershipStatus}
				stnkStatus={sub.stnkStatus}
				stnkTaxExpiry={sub.stnkTaxExpiry}
				hasFaktur={sub.hasFaktur}
				hasServiceBook={sub.hasServiceBook}
				hasSpareKey={sub.hasSpareKey}
				adminNotes={sub.adminNotes}
				isFloodFree={sub.isFloodFree}
				isAccidentFree={sub.isAccidentFree}
				conditionNotes={sub.conditionNotes}
				photos={sub.photos}
				documents={sub.documents}
			/>
		</Container>
	</Section>
</Layout>
