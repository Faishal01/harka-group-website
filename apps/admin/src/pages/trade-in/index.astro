---
export const prerender = false;

import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { getDb, getTradeInSubmissions } from "@harka/db";
import { env } from "cloudflare:workers";
import { getPrice } from "~/utils/helpers";

const db = getDb(env);
const submissions = await getTradeInSubmissions(db);

function getOwnershipBadge(status?: string | null) {
	if (status === "leasing") {
		return { label: "Leasing", badgeClass: "bg-amber-100 text-amber-800" };
	}
	if (status === "second_hand") {
		return { label: "Tangan Kedua", badgeClass: "bg-sky-100 text-sky-800" };
	}
	if (status === "company_car") {
		return { label: "Perusahaan", badgeClass: "bg-purple-100 text-purple-800" };
	}
	return { label: "Tangan Pertama", badgeClass: "bg-emerald-100 text-emerald-800" };
}
---

<Layout pageTitle="Pengajuan Tukar Tambah">
	<Section class="bg-gray-50 min-h-[85vh] py-8 sm:py-12">
		<Container>
			<!-- Header -->
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
				<div>
					<h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Pengajuan Tukar Tambah</h1>
					<p class="text-sm text-gray-500 mt-1">
						Daftar formulir taksiran dan tukar tambah mobil yang diajukan oleh calon pelanggan.
					</p>
				</div>
				<div class="flex items-center gap-2">
					<span
						class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200"
					>
						Total: {submissions.length} Pengajuan
					</span>
				</div>
			</div>

			{
				submissions.length === 0 ? (
					<div class="bg-white rounded-2xl border border-gray-200 p-12 text-center max-w-lg mx-auto shadow-sm">
						<div class="w-16 h-16 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="w-8 h-8"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
								/>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-gray-900 mb-1">Belum Ada Pengajuan</h3>
						<p class="text-sm text-gray-500">
							Pengajuan tukar tambah dari pengunjung website akan muncul di halaman ini.
						</p>
					</div>
				) : (
					<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse text-sm">
								<thead>
									<tr class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider">
										<th class="py-3.5 px-4 sm:px-6">Tanggal</th>
										<th class="py-3.5 px-4 sm:px-6">Pelanggan</th>
										<th class="py-3.5 px-4 sm:px-6">Kendaraan</th>
										<th class="py-3.5 px-4 sm:px-6">Ekspektasi Harga</th>
										<th class="py-3.5 px-4 sm:px-6">Status Berkas</th>
										<th class="py-3.5 px-4 sm:px-6 text-right">Aksi</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200">
									{submissions.map((sub) => {
										const formattedDate = new Date(sub.createdAt).toLocaleDateString("id-ID", {
											day: "numeric",
											month: "short",
											year: "numeric",
											hour: "2-digit",
											minute: "2-digit",
										});
										const cleanPhone = sub.customerPhone.replace(/[^0-9]/g, "");

										return (
											<tr class="hover:bg-gray-50/70 transition">
												<td class="py-4 px-4 sm:px-6 text-gray-500 text-xs whitespace-nowrap">
													{formattedDate}
													<span class="block font-mono text-[10px] text-gray-400 mt-0.5">
														ID: {sub.id}
													</span>
												</td>

												<td class="py-4 px-4 sm:px-6">
													<div class="font-bold text-gray-900">{sub.customerName}</div>
													<div class="text-xs text-gray-500 flex items-center gap-1.5 mt-0.5">
														<a
															href={`https://wa.me/${cleanPhone}`}
															target="_blank"
															rel="noopener noreferrer"
															class="text-green-700 font-semibold hover:underline inline-flex items-center gap-1"
														>
															<span>{sub.customerPhone}</span>
															<svg
																xmlns="http://www.w3.org/2000/svg"
																class="w-3 h-3"
																fill="none"
																viewBox="0 0 24 24"
																stroke="currentColor"
															>
																<path
																	stroke-linecap="round"
																	stroke-linejoin="round"
																	stroke-width="2"
																	d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
																/>
															</svg>
														</a>
													</div>
													<span class="text-[11px] text-gray-400 block">{sub.customerCity}</span>
												</td>

												<td class="py-4 px-4 sm:px-6">
													<div class="font-bold text-gray-900 flex items-center gap-2 flex-wrap">
														<span>
															{sub.year} {sub.make} {sub.model}
														</span>
														{sub.plateNumber && (
															<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-mono font-bold bg-gray-100 text-gray-700 border border-gray-200">
																{sub.plateNumber}
															</span>
														)}
													</div>
													<div class="text-xs text-gray-500">
														{sub.mileage.toLocaleString("id-ID")} KM &bull; {sub.transmission}
													</div>
													<div class="text-[11px] text-blue-600 font-medium mt-0.5">
														{sub.photos?.length || 0} Foto Terlampir
													</div>
												</td>

												<td class="py-4 px-4 sm:px-6">
													<span class="font-bold text-red-700 text-sm">
														{getPrice(sub.sellingPrice)}
													</span>
												</td>

												<td class="py-4 px-4 sm:px-6">
													<div class="flex flex-col gap-1">
														<span
															class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold w-fit ${getOwnershipBadge(sub.ownershipStatus).badgeClass}`}
														>
															BPKB: {getOwnershipBadge(sub.ownershipStatus).label}
														</span>
														<span
															class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium w-fit ${sub.stnkStatus === "expired" ? "bg-red-100 text-red-800" : "bg-gray-100 text-gray-700"}`}
														>
															STNK: {sub.stnkStatus === "expired" ? "Mati" : "Hidup"}
														</span>
													</div>
												</td>

												<td class="py-4 px-4 sm:px-6 text-right whitespace-nowrap">
													<a
														href={`/trade-in/${sub.id}`}
														class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-gray-900 text-white hover:bg-black font-semibold text-xs transition shadow-sm"
													>
														<span>Periksa Unit</span>
														<svg
															xmlns="http://www.w3.org/2000/svg"
															class="w-3.5 h-3.5"
															viewBox="0 0 20 20"
															fill="currentColor"
														>
															<path
																fill-rule="evenodd"
																d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
																clip-rule="evenodd"
															/>
														</svg>
													</a>
												</td>
											</tr>
										);
									})}
								</tbody>
							</table>
						</div>
					</div>
				)
			}
		</Container>
	</Section>
</Layout>
