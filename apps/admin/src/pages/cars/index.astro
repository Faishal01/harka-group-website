---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { getDb } from "@harka/db";
import { cars as carsTable } from "@harka/db";
import { isNull, isNotNull, eq, and, or } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { getPrice } from "~/utils/helpers";

const url = new URL(Astro.request.url);
const tab = url.searchParams.get("tab") || "active";

const db = getDb(env);
const allCars = await db.query.cars.findMany({
	where:
		tab === "sold"
			? and(isNotNull(carsTable.deletedAt), eq(carsTable.archiveReason, "sold"))
			: tab === "archived"
				? and(
						isNotNull(carsTable.deletedAt),
						or(eq(carsTable.archiveReason, "removed"), isNull(carsTable.archiveReason)),
					)
				: isNull(carsTable.deletedAt),
	orderBy: (cars, { desc }) => [desc(cars.publishDate)],
});
---

<Layout pageTitle="Admin - Cars">
	<Section class="bg-gray-50 min-h-[70vh]">
		<Container>
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-2xl md:text-3xl font-bold">Manage Cars</h1>
				<a
					href="/cars/new"
					class="hidden md:inline-block bg-blue-600 text-white font-semibold py-2 px-4 rounded hover:bg-blue-700 transition"
				>
					+ Add New Car
				</a>
			</div>

			<div class="mb-4 border-b border-gray-200">
				<nav class="-mb-px flex space-x-8" aria-label="Tabs">
					<a
						href="?tab=active"
						class={`${
							tab === "active"
								? "border-blue-500 text-blue-600"
								: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
						} whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium`}
					>
						Active Cars
					</a>
					<a
						href="?tab=sold"
						class={`${
							tab === "sold"
								? "border-blue-500 text-blue-600"
								: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
						} whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium`}
					>
						Sold
					</a>
					<a
						href="?tab=archived"
						class={`${
							tab === "archived"
								? "border-blue-500 text-blue-600"
								: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
						} whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium`}
					>
						Archived
					</a>
				</nav>
			</div>

			<div class="bg-white rounded-lg shadow overflow-x-auto">
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th
								class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider first:rounded-tl-lg"
								>Car</th
							>
							<th
								class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
								>Price</th
							>
							<th
								class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
							>
								{tab === "active" ? "Status" : tab === "sold" ? "Date Sold" : "Date Archived"}
							</th>
							<th
								class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider last:rounded-tr-lg"
								>Actions</th
							>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						{
							allCars.map((car) => (
								<tr>
									<td class="px-6 py-4 whitespace-nowrap">
										<div class="flex items-center">
											<div class="shrink-0 h-10 w-10 bg-gray-200 rounded overflow-hidden">
												{car.image ? (
													<img src={car.image} alt={car.imageAlt} class="h-10 w-10 object-cover" />
												) : (
													<div class="h-10 w-10 bg-gray-300" />
												)}
											</div>
											<div class="ml-4">
												<div class="text-sm font-medium text-gray-900">{car.title}</div>
												<div class="text-sm text-gray-500">
													{car.general.make} {car.general.model}
												</div>
											</div>
										</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap">
										<div class="text-sm text-gray-900">{getPrice(car.general.price)}</div>
									</td>

									{tab === "active" ? (
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="flex gap-2">
												{car.misc?.hidden && (
													<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800 border border-gray-200">
														Hidden
													</span>
												)}
												<span
													class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
														car.general?.availability === "reserved"
															? "bg-yellow-100 text-yellow-800 border border-yellow-200"
															: car.general?.availability === "coming-soon"
																? "bg-blue-100 text-blue-800 border border-blue-200"
																: "bg-green-100 text-green-800 border border-green-200"
													}`}
												>
													{car.general?.availability
														? car.general.availability
																.split("-")
																.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
																.join(" ")
														: "In Stock"}
												</span>
											</div>
										</td>
									) : (
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm font-medium text-gray-900">
												{car.deletedAt
													? car.deletedAt.toLocaleDateString("en-US", {
															year: "numeric",
															month: "long",
															day: "numeric",
														})
													: "Unknown"}
											</div>
										</td>
									)}

									<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
										<div class="flex justify-end gap-3 items-center">
											{car.deletedAt ? (
												<div class="flex items-center gap-4">
													<button
														type="button"
														class="text-green-600 hover:text-green-900 font-semibold restore-btn"
														data-id={car.id}
													>
														{tab === "sold" ? "Undo" : "Restore"}
													</button>

													<div class="relative quick-actions-wrapper">
														<button class="text-gray-500 hover:text-gray-700 flex items-center font-medium quick-actions-btn">
															<span class="hidden md:inline">Quick Actions</span>
															<span class="md:hidden tracking-widest text-lg leading-none">
																...
															</span>
															<svg
																xmlns="http://www.w3.org/2000/svg"
																class="h-4 w-4 ml-1"
																fill="none"
																viewBox="0 0 24 24"
																stroke="currentColor"
															>
																<path
																	stroke-linecap="round"
																	stroke-linejoin="round"
																	stroke-width="2"
																	d="M19 9l-7 7-7-7"
																/>
															</svg>
														</button>
														{/* Dropdown Menu */}
														<div class="absolute right-0 mt-2 w-40 bg-white rounded-md shadow-lg border border-gray-200 z-50 hidden quick-actions-menu">
															<div class="py-1 divide-y divide-gray-100">
																<div class="py-1">
																	<a
																		href={`/cars/view/${car.id}`}
																		class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
																	>
																		View Record
																	</a>
																</div>
																<div class="py-1">
																	<button
																		type="button"
																		class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 quick-archive-btn font-medium"
																		data-id={car.id}
																		data-reason="delete"
																	>
																		Hard Delete
																	</button>
																</div>
															</div>
														</div>
													</div>
												</div>
											) : (
												<div class="flex items-center gap-4">
													<a
														href={`/cars/edit/${car.id}`}
														class="text-blue-600 hover:text-blue-900 font-semibold"
													>
														Edit
													</a>

													<div class="relative quick-actions-wrapper">
														<button class="text-gray-500 hover:text-gray-700 flex items-center font-medium quick-actions-btn">
															Quick Actions
															<svg
																xmlns="http://www.w3.org/2000/svg"
																class="h-4 w-4 ml-1"
																fill="none"
																viewBox="0 0 24 24"
																stroke="currentColor"
															>
																<path
																	stroke-linecap="round"
																	stroke-linejoin="round"
																	stroke-width="2"
																	d="M19 9l-7 7-7-7"
																/>
															</svg>
														</button>
														{/* Dropdown Menu */}
														<div class="absolute right-0 mt-2 w-40 bg-white rounded-md shadow-lg border border-gray-200 z-50 hidden quick-actions-menu">
															<div class="py-1 divide-y divide-gray-100">
																<div class="py-1">
																	<button
																		type="button"
																		class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 quick-archive-btn"
																		data-id={car.id}
																		data-reason="sold"
																	>
																		Mark Sold
																	</button>
																	<button
																		type="button"
																		class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 quick-archive-btn"
																		data-id={car.id}
																		data-reason="removed"
																	>
																		Archive
																	</button>
																</div>
																<div class="py-1">
																	<button
																		type="button"
																		class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 quick-archive-btn font-medium"
																		data-id={car.id}
																		data-reason="delete"
																	>
																		Hard Delete
																	</button>
																</div>
															</div>
														</div>
													</div>
												</div>
											)}
										</div>
									</td>
								</tr>
							))
						}
						{
							allCars.length === 0 && (
								<tr>
									<td colspan="4" class="px-6 py-4 text-center text-gray-500">
										No cars found in this view.
									</td>
								</tr>
							)
						}
					</tbody>
				</table>
			</div>
		</Container>
	</Section>

	<!-- Dynamic Action Confirmation Modal -->
	<dialog
		id="action-modal"
		class="p-0 m-auto rounded-lg shadow-xl backdrop:bg-gray-800/50 open:animate-in open:fade-in-0 duration-200"
	>
		<div class="bg-white p-6 max-w-sm w-full">
			<h3 id="action-modal-title" class="text-lg font-bold mb-4 text-gray-900">Confirm Action</h3>
			<p id="action-modal-desc" class="text-sm text-gray-600 mb-6">
				Are you sure you want to proceed?
			</p>
			<div class="flex justify-end gap-3">
				<button
					type="button"
					class="px-4 py-2 text-gray-700 bg-gray-100 rounded hover:bg-gray-200 font-medium"
					id="btn-cancel-action">Cancel</button
				>
				<button
					type="button"
					class="px-4 py-2 text-white rounded font-medium transition-colors"
					id="btn-confirm-action">Confirm</button
				>
			</div>
		</div>
	</dialog>

	<!-- Toast UI Container -->
	<div
		id="toast-container"
		class="fixed top-20 right-4 md:right-8 z-50 animate-fade-in max-w-sm w-full shadow-xl rounded-lg border-l-4 p-4 bg-white border-green-500 hidden transition-opacity duration-300"
	>
		<div class="flex items-start gap-3">
			<svg
				class="h-6 w-6 text-green-500 flex-shrink-0"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"
				></path>
			</svg>
			<div class="flex-1">
				<h4 id="toast-title" class="font-bold text-gray-900">Success!</h4>
				<p id="toast-message" class="text-sm text-gray-600 mt-1">Action completed successfully.</p>
			</div>
			<button id="toast-close" class="ml-auto text-gray-400 hover:text-gray-600 flex-shrink-0">
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</div>

	<script>
		let isGlobalClickAttached = false;

		document.addEventListener("astro:page-load", () => {
			// Toast logic
			const params = new URLSearchParams(window.location.search);
			const toast = params.get("toast");
			if (toast) {
				const container = document.getElementById("toast-container");
				const titleEl = document.getElementById("toast-title");
				const messageEl = document.getElementById("toast-message");

				if (container && titleEl && messageEl) {
					if (toast === "created") {
						titleEl.textContent = "Vehicle Created!";
						messageEl.textContent = "The new car has been added to the inventory.";
					} else if (toast === "updated") {
						titleEl.textContent = "Vehicle Updated!";
						messageEl.textContent = "Your changes have been saved successfully.";
					} else if (toast === "deleted") {
						titleEl.textContent = "Vehicle Deleted!";
						messageEl.textContent = "The car has been moved to the archive.";
					}

					container.classList.remove("hidden");

					// Remove the param from URL without reloading
					const newUrl = new URL(window.location.href);
					newUrl.searchParams.delete("toast");
					window.history.replaceState({}, "", newUrl);

					// Auto hide
					setTimeout(() => {
						container.classList.add("opacity-0");
						setTimeout(() => container.classList.add("hidden"), 300);
					}, 4000);

					document.getElementById("toast-close")?.addEventListener("click", () => {
						container.classList.add("opacity-0");
						setTimeout(() => container.classList.add("hidden"), 300);
					});
				}
			}
			let currentAction: { id: string; type: "restore" | "sold" | "archive" | "delete" } | null =
				null;
			const modal = document.getElementById("action-modal") as HTMLDialogElement | null;
			const titleEl = document.getElementById("action-modal-title");
			const descEl = document.getElementById("action-modal-desc");
			const confirmBtn = document.getElementById("btn-confirm-action");

			document.getElementById("btn-cancel-action")?.addEventListener("click", () => {
				currentAction = null;
				modal?.close();
			});

			confirmBtn?.addEventListener("click", async () => {
				if (!currentAction) return;
				const { id, type } = currentAction;

				const originalText = confirmBtn.textContent;
				confirmBtn.textContent = "Processing...";
				confirmBtn.classList.add("opacity-50", "pointer-events-none");

				let res;
				if (type === "restore") {
					res = await fetch(`/api/cars/${id}/restore`, { method: "POST" });
				} else {
					res = await fetch(`/api/cars/${id}?reason=${type}`, { method: "DELETE" });
				}

				if (res.ok) {
					window.location.reload();
				} else {
					alert(`Failed to ${type} vehicle.`);
					confirmBtn.textContent = originalText;
					confirmBtn.classList.remove("opacity-50", "pointer-events-none");
					modal?.close();
				}
			});

			const openModal = (id: string, type: "restore" | "sold" | "archive" | "delete") => {
				currentAction = { id, type };
				if (!titleEl || !descEl || !confirmBtn) return;

				confirmBtn.className = "px-4 py-2 text-white rounded font-medium transition-colors ";

				if (type === "delete") {
					titleEl.textContent = "Confirm Hard Delete";
					descEl.textContent =
						"Are you sure you want to permanently delete this car? This action cannot be undone, and the associated images will be deleted from Cloudflare R2 storage.";
					confirmBtn.textContent = "Delete";
					confirmBtn.className += "bg-red-600 hover:bg-red-700";
				} else if (type === "sold") {
					titleEl.textContent = "Mark as Sold";
					descEl.textContent =
						"Are you sure you want to mark this car as SOLD? It will be moved to the Sold tab.";
					confirmBtn.textContent = "Mark Sold";
					confirmBtn.className += "bg-blue-600 hover:bg-blue-700";
				} else if (type === "archive") {
					titleEl.textContent = "Archive Vehicle";
					descEl.textContent =
						"Are you sure you want to ARCHIVE this car? It will be removed from the active list.";
					confirmBtn.textContent = "Archive";
					confirmBtn.className += "bg-yellow-600 hover:bg-yellow-700";
				} else if (type === "restore") {
					titleEl.textContent = "Restore Vehicle";
					descEl.textContent = "Are you sure you want to RESTORE this car back to active status?";
					confirmBtn.textContent = "Restore";
					confirmBtn.className += "bg-green-600 hover:bg-green-700";
				}

				modal?.showModal();
			};

			// Quick Actions Dropdown Logic
			document.querySelectorAll(".quick-actions-btn").forEach((btn) => {
				btn.addEventListener("click", () => {
					const menu = btn.nextElementSibling;
					const isHidden = menu?.classList.contains("hidden");

					// Close all other menus first
					document
						.querySelectorAll(".quick-actions-menu")
						.forEach((m) => m.classList.add("hidden"));

					// Toggle the clicked menu
					if (isHidden) {
						menu?.classList.remove("hidden");
					}
				});
			});

			// Close dropdowns when clicking outside
			if (!isGlobalClickAttached) {
				document.addEventListener("click", (e) => {
					const target = e.target;
					if (target instanceof Element && !target.closest(".quick-actions-wrapper")) {
						document.querySelectorAll(".quick-actions-menu").forEach((menu) => {
							menu.classList.add("hidden");
						});
					}
				});
				isGlobalClickAttached = true;
			}

			document.querySelectorAll(".restore-btn").forEach((btn) => {
				btn.addEventListener("click", (e) => {
					const target = e.currentTarget as HTMLElement;
					openModal(target.dataset.id!, "restore");
				});
			});

			document.querySelectorAll(".quick-archive-btn").forEach((btn) => {
				btn.addEventListener("click", (e) => {
					const target = e.currentTarget as HTMLElement;
					openModal(target.dataset.id!, target.dataset.reason as any);
				});
			});
		});
	</script>
	<a
		href="/cars/new"
		class="md:hidden fixed bottom-6 right-6 z-50 bg-blue-600 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:bg-blue-700 transition"
		aria-label="Add New Car"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			class="h-6 w-6"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
		>
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
			></path>
		</svg>
	</a>
</Layout>
