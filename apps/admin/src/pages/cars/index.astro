---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { getDb } from "@harka/db";
import { cars as carsTable } from "@harka/db";
import { isNull, isNotNull, eq, and, or } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { getPrice } from "~/utils/helpers";

const url = new URL(Astro.request.url);
const tab = url.searchParams.get("tab") || "active";

const db = getDb(env);
const allCars = await db.query.cars.findMany({
	where:
		tab === "sold"
			? and(isNotNull(carsTable.deletedAt), eq(carsTable.archiveReason, "sold"))
			: tab === "archived"
				? and(
						isNotNull(carsTable.deletedAt),
						or(eq(carsTable.archiveReason, "removed"), isNull(carsTable.archiveReason)),
					)
				: isNull(carsTable.deletedAt),
	orderBy: (cars, { desc }) => [desc(cars.publishDate)],
});
---

<Layout pageTitle="Admin - Kelola Stok Mobil">
	<Section class="bg-gray-50 min-h-[85vh] py-8 sm:py-12">
		<Container>
			<!-- Header -->
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
				<div>
					<h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Kelola Stok Mobil</h1>
					<p class="text-sm text-gray-500 mt-1">
						Kelola inventaris mobil, status publikasi, harga, dan arsip unit.
					</p>
				</div>
				<div class="flex items-center gap-3">
					<span
						class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200"
					>
						Total: {allCars.length} Unit
					</span>
					<a
						href="/cars/new"
						class="inline-flex items-center gap-2 bg-red-700 hover:bg-red-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition shadow-sm"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="w-4 h-4"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 4v16m8-8H4"></path>
						</svg>
						<span>Tambah Mobil Baru</span>
					</a>
				</div>
			</div>

			<!-- Tabs Bar -->
			<div class="mb-6 border-b border-gray-200">
				<nav class="-mb-px flex space-x-8" aria-label="Tabs">
					<a
						href="?tab=active"
						class={`${
							tab === "active"
								? "border-red-700 text-red-700 font-bold"
								: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 font-medium"
						} whitespace-nowrap border-b-2 py-3 px-1 text-sm transition`}
					>
						Mobil Aktif
					</a>
					<a
						href="?tab=sold"
						class={`${
							tab === "sold"
								? "border-red-700 text-red-700 font-bold"
								: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 font-medium"
						} whitespace-nowrap border-b-2 py-3 px-1 text-sm transition`}
					>
						Terjual
					</a>
					<a
						href="?tab=archived"
						class={`${
							tab === "archived"
								? "border-red-700 text-red-700 font-bold"
								: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 font-medium"
						} whitespace-nowrap border-b-2 py-3 px-1 text-sm transition`}
					>
						Diarsipkan
					</a>
				</nav>
			</div>

			{
				allCars.length === 0 ? (
					<div class="bg-white rounded-2xl border border-gray-200 p-12 text-center max-w-lg mx-auto shadow-sm">
						<div class="w-16 h-16 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="w-8 h-8"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
								/>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-gray-900 mb-1">
							{tab === "sold"
								? "Belum Ada Unit Terjual"
								: tab === "archived"
									? "Belum Ada Unit Diarsipkan"
									: "Belum Ada Mobil Aktif"}
						</h3>
						<p class="text-sm text-gray-500 mb-6">
							{tab === "active"
								? "Mulai tambahkan mobil baru ke inventaris showroom Anda."
								: "Data mobil dalam kategori ini akan muncul di sini."}
						</p>
						{tab === "active" && (
							<a
								href="/cars/new"
								class="inline-flex items-center gap-2 bg-red-700 text-white font-bold px-5 py-2.5 rounded-xl hover:bg-red-800 transition shadow-sm text-sm"
							>
								+ Tambah Mobil Sekarang
							</a>
						)}
					</div>
				) : (
					<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse text-sm">
								<thead>
									<tr class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider">
										<th class="py-3.5 px-4 sm:px-6">Mobil</th>
										<th class="py-3.5 px-4 sm:px-6">Harga Showroom</th>
										<th class="py-3.5 px-4 sm:px-6">
											{tab === "active"
												? "Status Publikasi"
												: tab === "sold"
													? "Tanggal Terjual"
													: "Tanggal Diarsipkan"}
										</th>
										<th class="py-3.5 px-4 sm:px-6 text-right">Aksi</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200">
									{allCars.map((car) => (
										<tr class="hover:bg-gray-50/70 transition">
											<td class="py-4 px-4 sm:px-6">
												<div class="flex items-center">
													<div class="shrink-0 h-12 w-12 bg-gray-100 rounded-xl overflow-hidden border border-gray-200">
														{car.gallery?.[0]?.image ? (
															<img
																src={car.gallery[0].image}
																alt={car.gallery[0].alt || car.title}
																class="h-12 w-12 object-cover"
															/>
														) : (
															<div class="h-12 w-12 bg-gray-200 flex items-center justify-center text-gray-400 text-xs">
																No Img
															</div>
														)}
													</div>
													<div class="ml-4">
														<a
															href={`/cars/view/${car.id}`}
															class="text-sm font-bold text-gray-900 hover:text-red-700 transition"
														>
															{car.title}
														</a>
														<div class="text-xs text-gray-500 flex items-center gap-2 mt-0.5">
															<span>
																{car.make} {car.model} ({car.year})
															</span>
															{car.plateNumber && (
																<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-mono font-bold bg-gray-100 text-gray-700 border border-gray-200">
																	{car.plateNumber}
																</span>
															)}
														</div>
													</div>
												</div>
											</td>
											<td class="py-4 px-4 sm:px-6 whitespace-nowrap">
												<span class="font-bold text-red-700 text-sm">{getPrice(car.price)}</span>
											</td>

											{tab === "active" ? (
												<td class="py-4 px-4 sm:px-6 whitespace-nowrap">
													<div class="flex gap-2 items-center">
														{car.hidden ? (
															<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-amber-50 text-amber-800 border border-amber-200">
																Hidden (Draf)
															</span>
														) : (
															<span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
																Publik (Live)
															</span>
														)}
													</div>
												</td>
											) : (
												<td class="py-4 px-4 sm:px-6 whitespace-nowrap">
													<div class="text-xs text-gray-700 font-medium">
														{car.deletedAt
															? new Date(car.deletedAt).toLocaleDateString("id-ID", {
																	year: "numeric",
																	month: "long",
																	day: "numeric",
																})
															: "Tidak diketahui"}
													</div>
												</td>
											)}

											<td class="py-4 px-4 sm:px-6 whitespace-nowrap text-right text-sm font-medium">
												<div class="flex justify-end gap-2 items-center">
													{car.deletedAt ? (
														<div class="flex items-center gap-2">
															<button
																type="button"
																class="px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 font-semibold text-xs transition restore-btn"
																data-id={car.id}
															>
																{tab === "sold" ? "Batal Terjual" : "Pulihkan"}
															</button>

															<div class="relative quick-actions-wrapper">
																<button class="border border-gray-200 bg-gray-50 hover:bg-gray-100 text-gray-700 px-2.5 py-1.5 rounded-lg flex items-center font-semibold text-xs quick-actions-btn transition-colors">
																	<span>Aksi Cepat</span>
																	<svg
																		xmlns="http://www.w3.org/2000/svg"
																		class="h-3.5 w-3.5 ml-1"
																		fill="none"
																		viewBox="0 0 24 24"
																		stroke="currentColor"
																	>
																		<path
																			stroke-linecap="round"
																			stroke-linejoin="round"
																			stroke-width="2"
																			d="M19 9l-7 7-7-7"
																		/>
																	</svg>
																</button>
																{/* Dropdown Menu */}
																<div class="fixed w-44 bg-white rounded-xl shadow-lg border border-gray-200 z-50 hidden quick-actions-menu overflow-hidden">
																	<div class="py-1 divide-y divide-gray-100">
																		<div class="py-1">
																			<a
																				href={`/cars/view/${car.id}`}
																				class="block w-full text-left px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50"
																			>
																				Lihat Detail
																			</a>
																		</div>
																		<div class="py-1">
																			<button
																				type="button"
																				class="block w-full text-left px-4 py-2 text-xs text-red-600 hover:bg-red-50 quick-archive-btn font-semibold"
																				data-id={car.id}
																				data-reason="delete"
																			>
																				Hapus Permanen
																			</button>
																		</div>
																	</div>
																</div>
															</div>
														</div>
													) : (
														<div class="flex items-center gap-2">
															<a
																href={`/cars/view/${car.id}`}
																class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold text-xs transition"
															>
																Lihat
															</a>
															<a
																href={`/cars/edit/${car.id}`}
																class="px-3 py-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-700 font-semibold text-xs transition"
															>
																Ubah
															</a>

															<div class="relative quick-actions-wrapper">
																<button class="border border-gray-200 bg-gray-50 hover:bg-gray-100 text-gray-700 px-2.5 py-1.5 rounded-lg flex items-center font-semibold text-xs quick-actions-btn transition-colors">
																	<span>Aksi Cepat</span>
																	<svg
																		xmlns="http://www.w3.org/2000/svg"
																		class="h-3.5 w-3.5 ml-1"
																		fill="none"
																		viewBox="0 0 24 24"
																		stroke="currentColor"
																	>
																		<path
																			stroke-linecap="round"
																			stroke-linejoin="round"
																			stroke-width="2"
																			d="M19 9l-7 7-7-7"
																		/>
																	</svg>
																</button>
																{/* Dropdown Menu */}
																<div class="fixed w-44 bg-white rounded-xl shadow-lg border border-gray-200 z-50 hidden quick-actions-menu overflow-hidden">
																	<div class="py-1 divide-y divide-gray-100">
																		<div class="py-1">
																			<button
																				type="button"
																				class="block w-full text-left px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 quick-archive-btn"
																				data-id={car.id}
																				data-reason="sold"
																			>
																				Tandai Terjual
																			</button>
																			<button
																				type="button"
																				class="block w-full text-left px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 quick-archive-btn"
																				data-id={car.id}
																				data-reason="removed"
																			>
																				Arsipkan
																			</button>
																		</div>
																		<div class="py-1">
																			<button
																				type="button"
																				class="block w-full text-left px-4 py-2 text-xs text-red-600 hover:bg-red-50 quick-archive-btn font-semibold"
																				data-id={car.id}
																				data-reason="delete"
																			>
																				Hapus Permanen
																			</button>
																		</div>
																	</div>
																</div>
															</div>
														</div>
													)}
												</div>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</div>
				)
			}
		</Container>
	</Section>

	<!-- Dynamic Action Confirmation Modal -->
	<dialog
		id="action-modal"
		class="p-0 m-auto rounded-2xl shadow-2xl backdrop:bg-gray-900/60 open:animate-in open:fade-in-0 duration-200 border-0"
	>
		<div class="bg-white p-6 max-w-sm w-full rounded-2xl">
			<h3 id="action-modal-title" class="text-lg font-bold mb-2 text-gray-900">Konfirmasi Aksi</h3>
			<p id="action-modal-desc" class="text-sm text-gray-600 mb-6">
				Apakah Anda yakin ingin melanjutkan?
			</p>
			<div class="flex justify-end gap-3">
				<button
					type="button"
					class="px-4 py-2 text-gray-700 bg-gray-100 rounded-xl hover:bg-gray-200 font-semibold text-sm transition"
					id="btn-cancel-action">Batal</button
				>
				<button
					type="button"
					class="px-4 py-2 text-white rounded-xl font-semibold text-sm transition shadow-sm"
					id="btn-confirm-action">Konfirmasi</button
				>
			</div>
		</div>
	</dialog>

	<!-- Toast UI Container -->
	<div
		id="toast-container"
		class="fixed top-6 right-4 md:right-8 z-50 animate-fade-in max-w-sm w-full shadow-xl rounded-2xl border p-4 bg-white border-green-500 ring-1 ring-green-500/20 hidden transition-opacity duration-300"
	>
		<div class="flex items-start gap-3">
			<svg
				class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"
				></path>
			</svg>
			<div class="flex-1">
				<h4 id="toast-title" class="font-bold text-gray-900 text-sm">Berhasil!</h4>
				<p id="toast-message" class="text-xs text-gray-600 mt-0.5">Aksi berhasil diselesaikan.</p>
			</div>
			<button
				id="toast-close"
				class="ml-auto text-gray-400 hover:text-gray-600 flex-shrink-0 text-sm font-bold"
			>
				✕
			</button>
		</div>
	</div>

	<script>
		let isGlobalClickAttached = false;

		document.addEventListener("astro:page-load", () => {
			// Toast logic
			const params = new URLSearchParams(window.location.search);
			const toast = params.get("toast");
			if (toast) {
				const container = document.getElementById("toast-container");
				const titleEl = document.getElementById("toast-title");
				const messageEl = document.getElementById("toast-message");

				if (container && titleEl && messageEl) {
					if (toast === "created") {
						titleEl.textContent = "Kendaraan Dibuat!";
						messageEl.textContent = "Mobil baru telah ditambahkan ke stok.";
					} else if (toast === "updated") {
						titleEl.textContent = "Kendaraan Diperbarui!";
						messageEl.textContent = "Perubahan Anda berhasil disimpan.";
					} else if (toast === "deleted") {
						titleEl.textContent = "Kendaraan Dihapus!";
						messageEl.textContent = "Mobil telah dipindahkan ke arsip.";
					}

					container.classList.remove("hidden");

					// Remove the param from URL without reloading
					const newUrl = new URL(window.location.href);
					newUrl.searchParams.delete("toast");
					window.history.replaceState({}, "", newUrl);

					// Auto hide
					setTimeout(() => {
						container.classList.add("opacity-0");
						setTimeout(() => container.classList.add("hidden"), 300);
					}, 4000);

					document.getElementById("toast-close")?.addEventListener("click", () => {
						container.classList.add("opacity-0");
						setTimeout(() => container.classList.add("hidden"), 300);
					});
				}
			}
			let currentAction: { id: string; type: "restore" | "sold" | "removed" | "delete" } | null =
				null;
			const modal = document.getElementById("action-modal") as HTMLDialogElement | null;
			const titleEl = document.getElementById("action-modal-title");
			const descEl = document.getElementById("action-modal-desc");
			const confirmBtn = document.getElementById("btn-confirm-action");

			document.getElementById("btn-cancel-action")?.addEventListener("click", () => {
				currentAction = null;
				modal?.close();
			});

			confirmBtn?.addEventListener("click", async () => {
				if (!currentAction) return;
				const { id, type } = currentAction;

				const originalText = confirmBtn.textContent;
				confirmBtn.textContent = "Processing...";
				confirmBtn.classList.add("opacity-50", "pointer-events-none");

				let res;
				if (type === "restore") {
					res = await fetch(`/api/cars/${id}/restore`, { method: "POST" });
				} else {
					res = await fetch(`/api/cars/${id}?reason=${type}`, { method: "DELETE" });
				}

				if (res.ok) {
					window.location.reload();
				} else {
					alert(`Gagal melakukan ${type} pada kendaraan.`);
					confirmBtn.textContent = originalText;
					confirmBtn.classList.remove("opacity-50", "pointer-events-none");
					modal?.close();
				}
			});

			const openModal = (id: string, type: "restore" | "sold" | "removed" | "delete") => {
				currentAction = { id, type };
				if (!titleEl || !descEl || !confirmBtn) return;

				confirmBtn.className = "px-4 py-2 text-white rounded font-medium transition-colors ";

				if (type === "delete") {
					titleEl.textContent = "Konfirmasi Hapus Permanen";
					descEl.textContent =
						"Apakah Anda yakin ingin menghapus mobil ini secara permanen? Aksi ini tidak dapat dibatalkan, dan gambar terkait akan dihapus dari penyimpanan Cloudflare R2.";
					confirmBtn.textContent = "Hapus";
					confirmBtn.className += "bg-red-600 hover:bg-red-700";
				} else if (type === "sold") {
					titleEl.textContent = "Tandai sebagai Terjual";
					descEl.textContent =
						"Apakah Anda yakin ingin menandai mobil ini sebagai TERJUAL? Mobil ini akan dipindahkan ke tab Terjual.";
					confirmBtn.textContent = "Tandai Terjual";
					confirmBtn.className += "bg-blue-600 hover:bg-blue-700";
				} else if (type === "removed") {
					titleEl.textContent = "Arsipkan Kendaraan";
					descEl.textContent =
						"Apakah Anda yakin ingin MENGARSIPKAN mobil ini? Mobil ini akan dihapus dari daftar aktif.";
					confirmBtn.textContent = "Arsipkan";
					confirmBtn.className += "bg-yellow-600 hover:bg-yellow-700";
				} else if (type === "restore") {
					titleEl.textContent = "Pulihkan Kendaraan";
					descEl.textContent =
						"Apakah Anda yakin ingin MEMULIHKAN mobil ini kembali ke status aktif?";
					confirmBtn.textContent = "Pulihkan";
					confirmBtn.className += "bg-green-600 hover:bg-green-700";
				}

				modal?.showModal();
			};

			// Aksi Cepat Dropdown Logic
			document.querySelectorAll(".quick-actions-btn").forEach((btn) => {
				btn.addEventListener("click", (e) => {
					const target = e.currentTarget as HTMLElement;
					const menu = target.nextElementSibling as HTMLElement;
					const isHidden = menu?.classList.contains("hidden");

					// Close all other menus first
					document
						.querySelectorAll(".quick-actions-menu")
						.forEach((m) => m.classList.add("hidden"));

					// Toggle the clicked menu
					if (isHidden) {
						menu?.classList.remove("hidden");

						// Use fixed positioning to escape table overflow clipping
						const rect = target.getBoundingClientRect();
						menu.style.top = `${rect.bottom + 8}px`; // Add 8px spacing
						// Align right edge of menu with right edge of button
						menu.style.left = `${rect.right - menu.offsetWidth}px`;
					}
				});
			});

			// Close dropdowns when clicking outside or scrolling
			if (!isGlobalClickAttached) {
				const closeAllMenus = () => {
					document.querySelectorAll(".quick-actions-menu").forEach((menu) => {
						menu.classList.add("hidden");
					});
				};

				document.addEventListener("click", (e) => {
					const target = e.target;
					if (target instanceof Element && !target.closest(".quick-actions-wrapper")) {
						closeAllMenus();
					}
				});

				// Capture scroll events on any element to close menus
				document.addEventListener("scroll", closeAllMenus, true);

				// Also close on window resize
				window.addEventListener("resize", closeAllMenus);

				isGlobalClickAttached = true;
			}

			document.querySelectorAll(".restore-btn").forEach((btn) => {
				btn.addEventListener("click", (e) => {
					const target = e.currentTarget as HTMLElement;
					openModal(target.dataset.id!, "restore");
				});
			});

			document.querySelectorAll(".quick-archive-btn").forEach((btn) => {
				btn.addEventListener("click", (e) => {
					const target = e.currentTarget as HTMLElement;
					openModal(
						target.dataset.id!,
						target.dataset.reason as "restore" | "sold" | "removed" | "delete",
					);
				});
			});
		});
	</script>
	<a
		href="/cars/new"
		class="md:hidden fixed bottom-6 right-6 z-50 bg-blue-600 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:bg-blue-700 transition"
		aria-label="Tambah Mobil Baru"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			class="h-6 w-6"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
		>
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
			></path>
		</svg>
	</a>
</Layout>
