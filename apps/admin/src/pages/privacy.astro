---
import Layout from "~/layouts/Layout.astro";
import { siteName, contactEmail, contactPhone, contactAddress } from "~/data/config";

const lastUpdated = "20 Oktober 2026";
---

<Layout
	title="Kebijakan Privasi | Harka Admin"
	pageTitle="Kebijakan Privasi - Harka Admin"
	hideSidebar={true}
>
	<div class="min-h-screen bg-gray-50 py-10 px-4 sm:px-6 lg:px-8">
		<div class="max-w-4xl mx-auto">
			<!-- Navigation / Back to Login -->
			<div class="mb-6 flex items-center justify-between">
				<a
					href="/login"
					class="inline-flex items-center text-sm font-medium text-red-700 hover:text-red-800 transition-colors"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-4 w-4 mr-1.5"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Kembali ke Halaman Masuk
				</a>
				<span class="text-xs text-gray-500">Pembaruan Terakhir: {lastUpdated}</span>
			</div>

			<!-- Main Content Card -->
			<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 sm:p-12">
				<header class="border-b border-gray-200 pb-8 mb-8">
					<div
						class="inline-block px-3 py-1 bg-red-50 text-red-700 rounded-full text-xs font-semibold tracking-wide uppercase mb-3"
					>
						Legal & Privasi
					</div>
					<h1 class="text-3xl font-extrabold text-gray-900 tracking-tight sm:text-4xl">
						Kebijakan Privasi Harka Admin
					</h1>
					<p class="mt-3 text-base text-gray-600">
						Kebijakan privasi ini menjelaskan bagaimana aplikasi <strong class="text-gray-900"
							>Harka Admin</strong
						> mengumpulkan, menggunakan, dan melindungi data akun Google yang Anda gunakan saat masuk
						ke portal administrasi internal {siteName}.
					</p>
				</header>

				<div class="space-y-8 text-gray-700 text-sm leading-relaxed sm:text-base">
					<!-- Section 1 -->
					<section>
						<h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
							<span
								class="flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold"
								>1</span
							>
							Ruang Lingkup Aplikasi
						</h2>
						<p>
							Harka Admin adalah sistem portal web internal yang dirancang khusus untuk manajemen
							inventaris kendaraan dan operasional showroom {siteName}. Aplikasi ini ditujukan hanya
							untuk staf dan administrator internal yang telah diberikan wewenang akses sebelumnya
							oleh pengelola {siteName}.
						</p>
					</section>

					<!-- Section 2 -->
					<section>
						<h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
							<span
								class="flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold"
								>2</span
							>
							Informasi yang Kami Akses melalui Google OAuth
						</h2>
						<p class="mb-3">
							Saat Anda menggunakan fitur <em>"Sign in with Google"</em>, aplikasi meminta izin
							akses dasar (non-sensitif) melalui Google OAuth 2.0 API:
						</p>
						<ul class="list-disc pl-6 space-y-2 text-gray-600">
							<li>
								<strong class="text-gray-900">Alamat Email:</strong> Digunakan untuk memverifikasi apakah
								akun Google Anda terdaftar dalam daftar putih (whitelist) administrator yang sah.
							</li>
							<li>
								<strong class="text-gray-900">Nama dan Profil Pengguna:</strong> Nama lengkap dan foto
								profil digunakan untuk menampilkan identitas pengguna yang sedang aktif pada bilah navigasi
								dasbor.
							</li>
							<li>
								<strong class="text-gray-900">ID Akun Google:</strong> Pengidentifikasi numerik unik untuk
								menghubungkan sesi masuk Anda secara aman dengan catatan autentikasi kami.
							</li>
						</ul>
						<p
							class="mt-3 text-xs sm:text-sm text-gray-500 bg-gray-50 p-4 rounded-lg border border-gray-100"
						>
							Kami <strong>tidak pernah</strong> meminta akses ke kontak, Google Drive, email pribadi
							(Gmail messages), kalender, lokasi, atau data sensitif Google lainnya di luar profil dasar
							dan email otorisasi.
						</p>
					</section>

					<!-- Section 3 -->
					<section>
						<h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
							<span
								class="flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold"
								>3</span
							>
							Tujuan Penggunaan Data
						</h2>
						<p>Data yang diperoleh dari akun Google Anda digunakan secara eksklusif untuk:</p>
						<ul class="list-disc pl-6 mt-2 space-y-1.5 text-gray-600">
							<li>Memproses autentikasi sesi masuk dan validasi otorisasi peran administrator.</li>
							<li>Menampilkan informasi profil sesi staf yang sedang bertugas.</li>
							<li>Mencatat riwayat aktivitas administratif untuk tujuan keamanan audit sistem.</li>
						</ul>
					</section>

					<!-- Section 4 -->
					<section>
						<h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
							<span
								class="flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold"
								>4</span
							>
							Pembagian dan Pengungkapan Data
						</h2>
						<div class="bg-amber-50 border-l-4 border-amber-400 p-4 rounded-r-lg mb-3">
							<p class="text-amber-900 font-medium">
								Kami tidak menjual, menyewakan, memperdagangkan, atau membagikan data profil dan
								email Google Anda kepada pihak ketiga mana pun.
							</p>
						</div>
						<p>
							Data pengguna Google tidak digunakan untuk keperluan iklan pihak ketiga, pemasaran,
							pembuatan profil komersial (profiling), maupun pelatihan model kecerdasan buatan (AI)
							publik.
						</p>
					</section>

					<!-- Section 5 -->
					<section>
						<h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
							<span
								class="flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold"
								>5</span
							>
							Penyimpanan dan Keamanan Data
						</h2>
						<p>
							Data sesi dan otorisasi disimpan menggunakan infrastruktur basis data yang aman
							(Cloudflare D1 & KV) dengan enkripsi saat transit (HTTPS/TLS) dan saat disimpan. Hak
							akses ke database hanya dimiliki oleh teknisi sistem {siteName} yang berwenang.
						</p>
					</section>

					<!-- Section 6 -->
					<section>
						<h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
							<span
								class="flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold"
								>6</span
							>
							Retensi dan Penghapusan Data
						</h2>
						<p>
							Data akun Anda disimpan selama Anda berstatus sebagai staf/administrator aktif di
							sistem kami. Jika Anda tidak lagi bekerja atau hak akses dicabut:
						</p>
						<ul class="list-disc pl-6 mt-2 space-y-1.5 text-gray-600">
							<li>
								Email Anda akan dihapus dari whitelist administrator dan seluruh sesi aktif akan
								dihentikan secara permanen.
							</li>
							<li>
								Anda dapat mencabut izin akses aplikasi Harka Admin kapan saja langsung melalui
								pengaturan akun Google Anda di <a
									href="https://myaccount.google.com/permissions"
									target="_blank"
									rel="noopener noreferrer"
									class="text-red-700 underline font-medium hover:text-red-800"
									>myaccount.google.com/permissions</a
								>.
							</li>
							<li>
								Anda juga dapat mengajukan permohonan penghapusan catatan sesi akun Anda dengan
								menghubungi email dukungan kami di <a
									href={`mailto:${contactEmail}`}
									class="text-red-700 underline font-medium hover:text-red-800">{contactEmail}</a
								>.
							</li>
						</ul>
					</section>

					<!-- Section 7 (Google Limited Use Disclosure) -->
					<section class="p-5 bg-gray-50 rounded-xl border border-gray-200">
						<h2 class="text-lg font-bold text-gray-900 mb-2">
							Kepatuhan Google API Services User Data Policy
						</h2>
						<p class="text-sm text-gray-700 leading-relaxed">
							Penggunaan dan transfer informasi yang diterima dari Google API oleh aplikasi <strong
								>Harka Admin</strong
							> ke aplikasi lainnya mematuhi <a
								href="https://developers.google.com/terms/api-services-user-data-policy"
								target="_blank"
								rel="noopener noreferrer"
								class="text-red-700 font-semibold underline hover:text-red-800"
								>Google API Services User Data Policy</a
							>, termasuk persyaratan <strong>Penggunaan Terbatas (Limited Use)</strong>.
						</p>
					</section>

					<!-- Section 8 -->
					<section class="pt-4 border-t border-gray-200">
						<h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
							<span
								class="flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-700 text-xs font-bold"
								>7</span
							>
							Kontak dan Dukungan
						</h2>
						<p class="mb-3">
							Apabila Anda memiliki pertanyaan terkait kebijakan privasi ini atau pengelolaan data
							akun administratif Anda, silakan hubungi tim pengelola {siteName}:
						</p>
						<div class="bg-gray-50 p-4 rounded-lg space-y-1.5 text-sm">
							<p><strong class="text-gray-900">Organisasi:</strong> {siteName}</p>
							<p>
								<strong class="text-gray-900">Email:</strong>
								<a href={`mailto:${contactEmail}`} class="text-red-700 hover:underline"
									>{contactEmail}</a>
							</p>
							<p><strong class="text-gray-900">Telepon:</strong> {contactPhone}</p>
							<p><strong class="text-gray-900">Alamat:</strong> {contactAddress}</p>
						</div>
					</section>
				</div>
			</div>

			<!-- Footer Note -->
			<div class="mt-8 text-center text-xs text-gray-500">
				&copy; {new Date().getFullYear()}
				{siteName}. Seluruh hak cipta dilindungi.
			</div>
		</div>
	</div>
</Layout>
