---
import Layout from "~/layouts/Layout.astro";
import { adminMenus } from "~/data/adminMenus";
---

<Layout title="Dashboard" hideSidebar={true}>
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
		<h1 class="text-3xl font-bold text-gray-900 mb-8">Management Dashboard</h1>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{
				adminMenus.map((menu) => (
					<a
						href={menu.disabled ? "#" : menu.url}
						class={`relative flex flex-col items-center justify-center p-8 rounded-xl border bg-white text-center transition-all duration-200 group ${
							menu.disabled
								? "border-gray-200 opacity-60 cursor-not-allowed"
								: "border-gray-200 hover:border-red-300 hover:shadow-md hover:-translate-y-1 cursor-pointer"
						}`}
					>
						<div
							class={`w-16 h-16 rounded-full flex items-center justify-center mb-4 transition-colors ${
								menu.disabled
									? "bg-gray-100 text-gray-400"
									: "bg-red-50 text-red-600 group-hover:bg-red-100"
							}`}
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-8 w-8"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								set:html={menu.icon}
							/>
						</div>

						<h3 class={`text-lg font-bold ${menu.disabled ? "text-gray-500" : "text-gray-900"}`}>
							{menu.label}
						</h3>

						{menu.badge && (
							<span class="absolute top-4 right-4 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
								{menu.badge}
							</span>
						)}
					</a>
				))
			}
		</div>
	</div>
</Layout>
