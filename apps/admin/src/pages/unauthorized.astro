---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Unauthorized | Harka Admin" hideSidebar={true}>
	<div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12 sm:px-6 lg:px-8">
		<div class="w-full max-w-md space-y-8 rounded-xl bg-white p-10 shadow-lg text-center">
			<div>
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-100">
					<svg
						class="h-6 w-6 text-red-600"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
						></path>
					</svg>
				</div>
				<h2 class="mt-6 text-3xl font-bold tracking-tight text-gray-900">Access Denied</h2>
				<p class="mt-2 text-sm text-gray-600">
					Your account is not authorized to access this dashboard.
				</p>
			</div>

			<div class="mt-8">
				<a href="/login" class="text-sm font-semibold text-blue-600 hover:text-blue-500">
					&larr; Back to login
				</a>
			</div>
		</div>
	</div>
</Layout>
