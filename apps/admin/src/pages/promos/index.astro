---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { getDb, promos as promosTable } from "@harka/db";
import { desc, asc } from "drizzle-orm";
import { env } from "cloudflare:workers";

const db = getDb(env);
const allPromos = await db
	.select()
	.from(promosTable)
	.orderBy(asc(promosTable.order), desc(promosTable.createdAt));
---

<Layout pageTitle="Admin - Kelola Promosi">
	<Section class="bg-gray-50 min-h-[85vh] py-8 sm:py-12">
		<Container>
			<!-- Header -->
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
				<div>
					<h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Kelola Promosi & Banner</h1>
					<p class="text-sm text-gray-500 mt-1">
						Atur banner promo beranda, filter otomatis stok, dan halaman landing kampanye.
					</p>
				</div>
				<div class="flex items-center gap-3">
					<span
						class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200"
					>
						Total: {allPromos.length} Kampanye
					</span>
					<a
						href="/promos/new"
						class="inline-flex items-center gap-2 bg-red-700 hover:bg-red-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition shadow-sm"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="w-4 h-4"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 4v16m8-8H4"></path>
						</svg>
						<span>Tambah Promo Baru</span>
					</a>
				</div>
			</div>

			<!-- Table / List -->
			{
				allPromos.length === 0 ? (
					<div class="bg-white rounded-2xl border border-gray-200 p-12 text-center max-w-lg mx-auto shadow-sm">
						<div class="w-16 h-16 bg-red-50 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="w-8 h-8"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
								/>
							</svg>
						</div>
						<h3 class="text-lg font-bold text-gray-900 mb-1">Belum Ada Promo</h3>
						<p class="text-sm text-gray-500 mb-6">
							Buat banner promo pertama Anda untuk memikat pengunjung showroom beranda.
						</p>
						<a
							href="/promos/new"
							class="inline-flex items-center gap-2 bg-red-700 text-white font-bold px-5 py-2.5 rounded-xl hover:bg-red-800 transition shadow-sm text-sm"
						>
							+ Buat Promo Sekarang
						</a>
					</div>
				) : (
					<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse text-sm">
								<thead>
									<tr class="bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider">
										<th class="py-3.5 px-4 sm:px-6">Banner Promo</th>
										<th class="py-3.5 px-4 sm:px-6">Mode & Kriteria</th>
										<th class="py-3.5 px-4 sm:px-6">Jadwal & Status</th>
										<th class="py-3.5 px-4 sm:px-6">Urutan</th>
										<th class="py-3.5 px-4 sm:px-6 text-right">Aksi</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200">
									{allPromos.map((p) => {
										const now = new Date();
										const isExpired = p.endDate && new Date(p.endDate) < now;
										const isPending = p.startDate && new Date(p.startDate) > now;

										return (
											<tr class="hover:bg-gray-50/70 transition">
												<td class="py-4 px-4 sm:px-6">
													<div class="flex items-center gap-4">
														<div class="shrink-0 w-28 aspect-[2.5/1] bg-gray-900 rounded-lg overflow-hidden border border-gray-200 shadow-xs">
															<img
																src={p.bannerImage}
																alt={p.title}
																class="size-full object-cover"
															/>
														</div>
														<div class="min-w-0">
															<span class="text-sm font-bold text-gray-900 block truncate">
																{p.title}
															</span>
															<a
																href={`https://harkagroup.id/promo/${p.slug}`}
																target="_blank"
																rel="noopener noreferrer"
																class="text-xs text-red-600 hover:text-red-700 font-mono inline-flex items-center gap-1 mt-0.5"
															>
																<span>/promo/{p.slug}</span>
																<svg
																	xmlns="http://www.w3.org/2000/svg"
																	class="size-3"
																	fill="none"
																	viewBox="0 0 24 24"
																	stroke="currentColor"
																>
																	<path
																		stroke-linecap="round"
																		stroke-linejoin="round"
																		stroke-width="2"
																		d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
																	/>
																</svg>
															</a>
														</div>
													</div>
												</td>

												<td class="py-4 px-4 sm:px-6">
													{p.mode === "filter" ? (
														<div>
															<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
																Filter Otomatis
															</span>
															<div class="text-xs text-gray-500 mt-1">
																{p.filterParams?.make && <span>Merek: {p.filterParams.make} </span>}
																{p.filterParams?.bodyType && (
																	<span>• {p.filterParams.bodyType} </span>
																)}
																{p.filterParams?.maxPrice && (
																	<span>
																		• &lt; Rp{" "}
																		{(p.filterParams.maxPrice / 1_000_000).toLocaleString("id-ID")}{" "}
																		Jt
																	</span>
																)}
																{!p.filterParams?.make &&
																	!p.filterParams?.bodyType &&
																	!p.filterParams?.maxPrice && <span>Semua Unit</span>}
															</div>
														</div>
													) : (
														<div>
															<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200">
																Unit Kustom
															</span>
															<div class="text-xs text-gray-500 mt-1">
																{p.customCarIds?.length || 0} unit dipilih
															</div>
														</div>
													)}
												</td>

												<td class="py-4 px-4 sm:px-6 whitespace-nowrap">
													<div class="flex flex-col gap-1">
														<div>
															{p.isActive ? (
																isExpired ? (
																	<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
																		Kedaluwarsa
																	</span>
																) : isPending ? (
																	<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-cyan-50 text-cyan-800 border border-cyan-200">
																		Terjadwal
																	</span>
																) : (
																	<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
																		Aktif (Live)
																	</span>
																)
															) : (
																<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200">
																	Nonaktif
																</span>
															)}
														</div>
														{(p.startDate || p.endDate) && (
															<span class="text-[11px] text-gray-400">
																{p.startDate
																	? new Date(p.startDate).toLocaleDateString("id-ID")
																	: "Mulai"}{" "}
																-{" "}
																{p.endDate
																	? new Date(p.endDate).toLocaleDateString("id-ID")
																	: "Seterusnya"}
															</span>
														)}
													</div>
												</td>

												<td class="py-4 px-4 sm:px-6 whitespace-nowrap text-sm text-gray-600 font-mono">
													#{p.order}
												</td>

												<td class="py-4 px-4 sm:px-6 whitespace-nowrap text-right">
													<div class="flex items-center justify-end gap-2">
														<a
															href={`/promos/edit/${p.id}`}
															class="p-2 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition"
															title="Ubah promo"
														>
															<svg
																xmlns="http://www.w3.org/2000/svg"
																class="size-4"
																fill="none"
																viewBox="0 0 24 24"
																stroke="currentColor"
															>
																<path
																	stroke-linecap="round"
																	stroke-linejoin="round"
																	stroke-width="2"
																	d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
																/>
															</svg>
														</a>
														<button
															type="button"
															data-id={p.id}
															data-title={p.title}
															class="btn-delete p-2 text-gray-400 hover:text-red-700 hover:bg-red-50 rounded-lg transition"
															title="Hapus promo"
														>
															<svg
																xmlns="http://www.w3.org/2000/svg"
																class="size-4"
																fill="none"
																viewBox="0 0 24 24"
																stroke="currentColor"
															>
																<path
																	stroke-linecap="round"
																	stroke-linejoin="round"
																	stroke-width="2"
																	d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
																/>
															</svg>
														</button>
													</div>
												</td>
											</tr>
										);
									})}
								</tbody>
							</table>
						</div>
					</div>
				)
			}
		</Container>
	</Section>
</Layout>

<script>
	document.addEventListener("astro:page-load", () => {
		const deleteButtons = document.querySelectorAll(".btn-delete");
		deleteButtons.forEach((btn) => {
			btn.addEventListener("click", async () => {
				const id = btn.getAttribute("data-id");
				const title = btn.getAttribute("data-title");
				if (!id) return;

				const confirmed = window.confirm(`Apakah Anda yakin ingin menghapus promo "${title}"?`);
				if (!confirmed) return;

				try {
					const res = await fetch(`/api/promos/${id}`, { method: "DELETE" });
					if (!res.ok) {
						const data = (await res.json()) as { error?: string };
						throw new Error(data.error || "Gagal menghapus promo");
					}
					window.location.reload();
				} catch (err) {
					alert(err instanceof Error ? err.message : "Gagal menghapus promo");
				}
			});
		});
	});
</script>
