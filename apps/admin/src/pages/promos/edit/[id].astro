---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import PromoForm from "~/components/admin/PromoForm.svelte";
import { getDb, promos as promosTable, cars as carsTable } from "@harka/db";
import { eq, isNull, desc, asc } from "drizzle-orm";
import { env } from "cloudflare:workers";

const { id } = Astro.params;
if (!id) {
	return Astro.redirect("/promos");
}

const db = getDb(env);
const promoResults = await db.select().from(promosTable).where(eq(promosTable.id, id)).limit(1);
const promo = promoResults[0];

if (!promo) {
	return Astro.redirect("/promos");
}

const allCars = await db
	.select()
	.from(carsTable)
	.where(isNull(carsTable.deletedAt))
	.orderBy(desc(carsTable.createdAt));

const makeRows = await db
	.selectDistinct({ make: carsTable.make })
	.from(carsTable)
	.where(isNull(carsTable.deletedAt))
	.orderBy(asc(carsTable.make));
const availableMakes = makeRows.map((r) => r.make).filter(Boolean);
---

<Layout pageTitle={`Admin - Edit Promo: ${promo.title}`}>
	<Section class="bg-gray-50 min-h-[85vh] py-8 sm:py-12">
		<Container>
			<div class="max-w-4xl mx-auto mb-6">
				<a
					href="/promos"
					class="text-gray-500 hover:text-gray-900 transition inline-flex items-center text-sm font-medium"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-4 mr-1.5"
						viewBox="0 0 20 20"
						fill="currentColor"
					>
						<path
							fill-rule="evenodd"
							d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
							clip-rule="evenodd"></path>
					</svg>
					Kembali ke Kelola Promosi
				</a>
			</div>

			<div class="max-w-4xl mx-auto">
				<div class="mb-8">
					<h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Ubah Promo: {promo.title}</h1>
					<p class="text-sm text-gray-500 mt-1">
						Perbarui banner, kriteria filter, atau daftar mobil terpilih untuk kampanye ini.
					</p>
				</div>

				<PromoForm client:load promo={promo} cars={allCars} availableMakes={availableMakes} />
			</div>
		</Container>
	</Section>
</Layout>
