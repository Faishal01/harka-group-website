---
import { getPrice } from "~/utils/helpers";
import type { TradeInPhoto } from "@harka/db";

interface Props {
	make: string;
	model: string;
	year: number;
	mileage: number;
	transmission: string;
	fuelType?: string | null;
	sellingPrice?: number | null;
	priceLabel?: string;

	// Administration
	plateNumber?: string | null;
	bpkbStatus?: "on_hand" | "leasing" | string | null;
	stnkStatus?: "active" | "expired" | string | null;
	stnkTaxExpiry?: string | null;
	hasFaktur?: boolean;
	hasServiceBook?: boolean;
	hasSpareKey?: boolean;
	adminNotes?: string | null;

	// Condition & History
	isFloodFree?: boolean;
	isAccidentFree?: boolean;
	hasAccidentDamage?: boolean;
	hasFloodDamage?: boolean;
	conditionNotes?: string | null;

	// Photos
	photos?: Array<TradeInPhoto | { slot?: string; label?: string; url: string }> | null;
}

const {
	make,
	model,
	year,
	mileage,
	transmission,
	fuelType,
	sellingPrice,
	priceLabel = "Ekspektasi Harga Jual",
	plateNumber,
	bpkbStatus,
	stnkStatus,
	stnkTaxExpiry,
	hasFaktur = false,
	hasServiceBook = false,
	hasSpareKey = false,
	adminNotes,
	isFloodFree,
	isAccidentFree,
	hasAccidentDamage,
	hasFloodDamage,
	conditionNotes,
	photos = [],
} = Astro.props;

const floodFree = isFloodFree !== undefined ? isFloodFree : !hasFloodDamage;
const accidentFree = isAccidentFree !== undefined ? isAccidentFree : !hasAccidentDamage;
---

<div class="space-y-8">
	<!-- Top Specs & Highlights -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8">
		<div
			class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-gray-200"
		>
			<div>
				<div class="flex items-center gap-2 mb-1.5">
					<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700">
						Tahun {year}
					</span>
					{
						fuelType && (
							<span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
								{fuelType}
							</span>
						)
					}
					<span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
						{transmission}
					</span>
				</div>
				<div class="flex items-center gap-3 flex-wrap">
					<h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
						{`${make} ${model}`}
					</h2>
					{
						plateNumber && (
							<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-gray-100 text-gray-700 border border-gray-200">
								{plateNumber}
							</span>
						)
					}
				</div>
			</div>

			{
				sellingPrice && (
					<div class="bg-red-50 rounded-xl px-5 py-3 border border-red-100 shrink-0 text-left md:text-right">
						<span class="text-xs font-bold text-red-600 uppercase tracking-wide block">
							{priceLabel}
						</span>
						<span class="text-2xl sm:text-3xl font-extrabold text-red-700">
							{getPrice(sellingPrice)}
						</span>
					</div>
				)
			}
		</div>

		<!-- Quick Specs Grid -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6">
			<div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
				<span class="text-xs text-gray-500 block">Jarak Tempuh (KM)</span>
				<span class="text-base font-bold text-gray-900">{mileage.toLocaleString("id-ID")} KM</span>
			</div>

			<div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
				<span class="text-xs text-gray-500 block">Transmisi</span>
				<span class="text-base font-bold text-gray-900">{transmission}</span>
			</div>

			<div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
				<span class="text-xs text-gray-500 block">Status BPKB</span>
				<span
					class={`text-sm font-bold block ${bpkbStatus === "leasing" ? "text-amber-700" : "text-green-700"}`}
				>
					{bpkbStatus === "leasing" ? "Masih Leasing" : "Di Tangan (Lunas)"}
				</span>
			</div>

			<div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
				<span class="text-xs text-gray-500 block">Status Pajak STNK</span>
				<span
					class={`text-sm font-bold block ${stnkStatus === "expired" ? "text-red-700" : "text-green-700"}`}
				>
					{stnkStatus === "expired" ? "Pajak Mati" : "Pajak Hidup"}
				</span>
				{stnkTaxExpiry && <span class="text-[11px] text-gray-500 block">Exp: {stnkTaxExpiry}</span>}
			</div>
		</div>
	</div>

	<!-- Administration & Document Details -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8">
		<h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-5 h-5 text-red-700"
				viewBox="0 0 20 20"
				fill="currentColor"
			>
				<path
					fill-rule="evenodd"
					d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z"
					clip-rule="evenodd"></path>
			</svg>
			Kelengkapan Berkas & Legalitas
		</h3>

		<div
			class="p-3.5 bg-gray-50 rounded-lg border border-gray-200 mb-4 flex items-center justify-between"
		>
			<span class="text-sm font-semibold text-gray-700">Nomor Polisi / Plat Kendaraan</span>
			<span class="text-base font-mono font-bold text-gray-900">{plateNumber || "-"}</span>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
			<div
				class={`p-3 rounded-lg border flex items-center gap-2.5 ${hasFaktur ? "bg-green-50 border-green-200 text-green-800" : "bg-gray-50 border-gray-200 text-gray-500"}`}
			>
				<span>{hasFaktur ? "✓" : "✕"}</span>
				<span class="text-sm font-semibold">Faktur Pembelian</span>
			</div>

			<div
				class={`p-3 rounded-lg border flex items-center gap-2.5 ${hasServiceBook ? "bg-green-50 border-green-200 text-green-800" : "bg-gray-50 border-gray-200 text-gray-500"}`}
			>
				<span>{hasServiceBook ? "✓" : "✕"}</span>
				<span class="text-sm font-semibold">Buku Servis & Manual</span>
			</div>

			<div
				class={`p-3 rounded-lg border flex items-center gap-2.5 ${hasSpareKey ? "bg-green-50 border-green-200 text-green-800" : "bg-gray-50 border-gray-200 text-gray-500"}`}
			>
				<span>{hasSpareKey ? "✓" : "✕"}</span>
				<span class="text-sm font-semibold">Kunci Cadangan</span>
			</div>
		</div>

		{
			adminNotes && (
				<div class="mt-4 p-4 bg-gray-50 rounded-lg border border-gray-200 text-sm">
					<span class="font-bold text-gray-700 block mb-1">Catatan Administrasi:</span>
					<p class="text-gray-600 whitespace-pre-line">{adminNotes}</p>
				</div>
			)
		}
	</div>

	<!-- Condition & Damage History -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8">
		<h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-5 h-5 text-red-700"
				viewBox="0 0 20 20"
				fill="currentColor"
			>
				<path
					fill-rule="evenodd"
					d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"
					clip-rule="evenodd"></path>
			</svg>
			Riwayat & Kondisi Fisik Kendaraan
		</h3>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
			<div
				class={`p-4 rounded-xl border flex items-center justify-between ${!floodFree ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"}`}
			>
				<div>
					<span class="text-xs text-gray-500 block">Riwayat Terendam Banjir</span>
					<span class={`text-sm font-bold ${!floodFree ? "text-red-800" : "text-green-800"}`}>
						{floodFree ? "🌊 Bebas Riwayat Banjir" : "⚠️ Pernah Terendam Banjir"}
					</span>
				</div>
			</div>

			<div
				class={`p-4 rounded-xl border flex items-center justify-between ${!accidentFree ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"}`}
			>
				<div>
					<span class="text-xs text-gray-500 block">Riwayat Laka / Tabrakan</span>
					<span class={`text-sm font-bold ${!accidentFree ? "text-red-800" : "text-green-800"}`}>
						{accidentFree ? "🛡️ Bebas Lakalantas" : "⚠️ Pernah Mengalami Lakalantas"}
					</span>
				</div>
			</div>
		</div>

		{
			conditionNotes ? (
				<div class="p-4 bg-gray-50 rounded-lg border border-gray-200 text-sm">
					<span class="font-bold text-gray-700 block mb-1">Catatan Kondisi dari Pengguna:</span>
					<p class="text-gray-600 whitespace-pre-line">{conditionNotes}</p>
				</div>
			) : (
				<p class="text-xs text-gray-400 italic">
					Tidak ada catatan kondisi khusus yang dicantumkan.
				</p>
			)
		}
	</div>

	<!-- Photos Gallery Inspection Grid -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8">
		<div class="flex items-center justify-between mb-4">
			<h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-5 h-5 text-red-700"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
					></path>
				</svg>
				Galeri Foto Kendaraan ({photos?.length || 0} Foto)
			</h3>
		</div>

		{
			photos && photos.length > 0 ? (
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
					{photos.map((photo, idx) => (
						<div class="group relative rounded-lg overflow-hidden border border-gray-200 bg-gray-100 flex flex-col">
							<a
								href={photo.url}
								target="_blank"
								rel="noopener noreferrer"
								class="block aspect-video overflow-hidden relative"
							>
								<img
									src={photo.url}
									alt={photo.label || `Foto ${idx + 1}`}
									class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs font-semibold gap-1">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-4 h-4"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
										/>
									</svg>
									Lihat Resolusi Penuh
								</div>
							</a>
							<div class="p-2.5 bg-white border-t border-gray-100 flex justify-between items-center text-xs">
								<span class="font-bold text-gray-800 truncate">
									{photo.label || `Foto ${idx + 1}`}
								</span>
								{photo.slot && (
									<span class="font-mono text-[10px] text-gray-400 uppercase">{photo.slot}</span>
								)}
							</div>
						</div>
					))}
				</div>
			) : (
				<p class="text-sm text-gray-400 italic">Tidak ada foto yang dilampirkan.</p>
			)
		}
	</div>
</div>
