---
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { siteName, siteLang, themeColor, liveSiteUrl } from "~/data/config";
import icon from "~/assets/images/icons/logo.png";
import { Image } from "astro:assets";

const baseUrl = `${Astro.url.protocol}//${Astro.url.host}`;
const { pageTitle, title, description, noindex = false } = Astro.props;

interface Props {
	pageTitle?: string;
	title?: string;
	description?: string;
	noindex?: boolean;
}

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="author" href="humans.txt" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content={siteName} />

		<meta property="og:url" content={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${title} | ${siteName}`} />
		<meta property="og:image" content={`${baseUrl}/images/og-image.jpg`} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={siteLang} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={`${title} | ${siteName}`} />
		<meta name="twitter:description" content={description} />

		<title>{pageTitle}</title>
		<ClientRouter />
	</head>
	<body class="bg-gray-50 flex flex-col h-screen overflow-hidden">
		<!-- Top Header -->
		<header
			class="h-16 bg-red-700 text-white flex items-center justify-between px-6 flex-shrink-0 z-20 shadow"
		>
			<a href="/" class="flex items-center gap-x-2">
				<Image src={icon} class="h-10 w-auto inline-block" alt="Logo" />
				<span class="font-bold text-xl lg:text-2xl"
					>Harka <span class="font-normal">Admin</span></span
				>
			</a>
			<div class="flex items-center gap-4">
				<a
					href={liveSiteUrl}
					target="_blank"
					class="text-sm font-medium hover:text-red-200 transition">View Live Site</a
				>
				<span
					class="text-sm bg-red-800 px-3 py-1 rounded-full border border-red-600 shadow-sm hidden md:inline-block"
					>Admin Dashboard</span
				>
			</div>
		</header>

		<div class="flex flex-1 overflow-hidden">
			<!-- Sidebar Navigation -->
			<aside
				class="w-64 bg-white border-r border-gray-200 flex-shrink-0 flex flex-col shadow-sm hidden md:flex z-10"
			>
				<nav class="flex-1 px-4 py-6 space-y-2">
					<div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 px-2">
						Management
					</div>

					<a
						href="/cars"
						class={`flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition ${pathname.startsWith("/cars") ? "bg-red-50 text-red-700" : "text-gray-700 hover:bg-gray-100"}`}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-5 w-5 opacity-75"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
							></path>
						</svg>
						Inventory
					</a>

					<a
						href="#"
						class={`flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition text-gray-400 cursor-not-allowed`}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-5 w-5 opacity-50"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
							></path>
						</svg>
						Team (Soon)
					</a>

					<a
						href="#"
						class={`flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition text-gray-400 cursor-not-allowed`}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-5 w-5 opacity-50"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
							></path>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
						Settings (Soon)
					</a>
				</nav>
			</aside>

			<!-- Main Content -->
			<main class="flex-1 overflow-y-auto bg-gray-50 pb-12 w-full">
				<slot />
			</main>
		</div>
	</body>
</html>

<script>
	document.addEventListener("astro:after-swap", () => {
		const main = document.querySelector("main");
		if (main) main.scrollTo({ top: 0, behavior: "instant" });
	});
</script>
