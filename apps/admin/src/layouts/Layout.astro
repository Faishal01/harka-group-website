---
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { siteName, siteLang, themeColor, liveSiteUrl } from "~/data/config";
import icon from "~/assets/images/icons/logo.png";
import { Image } from "astro:assets";
import { adminMenus } from "~/data/adminMenus";

const baseUrl = `${Astro.url.protocol}//${Astro.url.host}`;
const { pageTitle, title, description, noindex = false, hideSidebar = false } = Astro.props;

interface Props {
	pageTitle?: string;
	title?: string;
	description?: string;
	noindex?: boolean;
	hideSidebar?: boolean;
}

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="author" href="humans.txt" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content={siteName} />

		<meta property="og:url" content={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${title} | ${siteName}`} />
		<meta property="og:image" content={`${baseUrl}/images/og-image.jpg`} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={siteLang} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={`${title} | ${siteName}`} />
		<meta name="twitter:description" content={description} />

		<title>{pageTitle}</title>
		<ClientRouter />
	</head>
	<body class="bg-gray-50 flex flex-col h-screen overflow-hidden">
		<!-- Top Header -->
		<header
			class="h-16 bg-red-700 text-white flex items-center justify-between px-6 flex-shrink-0 z-20 shadow"
		>
			<a href="/" class="flex items-center gap-x-2">
				<Image src={icon} class="h-10 w-auto inline-block" alt="Logo" />
				<span class="font-bold text-xl lg:text-2xl"
					>Harka <span class="font-normal">Admin</span></span
				>
			</a>
			<div class="flex items-center gap-4">
				<a
					href={liveSiteUrl}
					target="_blank"
					class="text-sm font-medium hover:text-red-200 transition">View Live Site</a
				>
				<span
					class="text-sm bg-red-800 px-3 py-1 rounded-full border border-red-600 shadow-sm hidden md:inline-block"
					>Admin Dashboard</span
				>
			</div>
		</header>

		<div class="flex flex-1 overflow-hidden">
			<!-- Sidebar Navigation -->
			{
				!hideSidebar && (
					<aside class="w-64 bg-white border-r border-gray-200 flex-shrink-0 flex flex-col shadow-sm hidden md:flex z-10">
						<nav class="flex-1 px-4 py-6 space-y-2">
							<div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 px-2">
								Management
							</div>
							{adminMenus.map((menu) => (
								<a
									href={menu.disabled ? "#" : menu.url}
									class={`flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition ${menu.disabled ? "text-gray-400 cursor-not-allowed" : pathname.startsWith(menu.url) && menu.url !== "/" ? "bg-red-50 text-red-700" : "text-gray-700 hover:bg-gray-100"}`}
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class={`h-5 w-5 ${menu.disabled ? "opacity-50" : "opacity-75"}`}
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										set:html={menu.icon}
									/>
									{menu.label} {menu.badge && `(${menu.badge})`}
								</a>
							))}
						</nav>
					</aside>
				)
			}

			<!-- Main Content -->
			<main class="flex-1 overflow-y-auto bg-gray-50 pb-12 w-full">
				<slot />
			</main>
		</div>
	</body>
</html>

<script>
	document.addEventListener("astro:after-swap", () => {
		const main = document.querySelector("main");
		if (main) main.scrollTo({ top: 0, behavior: "instant" });
	});
</script>
