{
  "name": "@harka/db",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:prod": "wrangler d1 migrations apply harka-db --remote",
    "db:migrate:dev": "wrangler d1 migrations apply harka-db --local --persist-to ../../.wrangler/state",
    "db:migrate:list:prod": "wrangler d1 migrations list harka-db --remote",
    "db:migrate:list:dev": "wrangler d1 migrations list harka-db --local --persist-to ../../.wrangler/state",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.3",
    "wrangler": "^4.125.0"
  }
}
