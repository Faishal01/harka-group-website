---
export const prerender = false;
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import Button from "~/components/Button.astro";
import Heading from "~/components/Heading.astro";

import ShowCars from "~/components/ShowCars.astro";

// Images
import ImageHeadingBackground from "~/assets/images/pexels-jeshoots-com-147458-451590.jpg";
---

<Layout pageTitle="Home">
	{/* Main Heading */}
	<Section class:list={"relative"}>
		<Image
			src={ImageHeadingBackground}
			alt="Heading background"
			class:list={"absolute inset-0 w-full h-full object-cover"}
		/>
		<div class="absolute inset-0 w-full h-full object-cover bg-gray-800/80"></div>
		<Container class:list={"relative z-10"}>
			<Heading class:list={"prose-invert max-w-4xl"}>
				<h1 slot="heading-title" class="mb-0 lg:text-7xl text-balance">
					Find your next car in our exclusive collection
				</h1>
				<p slot="heading-content">
					Search for your next car here. We have a wide range of cars for sale. Browse through our
					collection and find the perfect car that suits your needs and budget.
				</p>
			</Heading>
			<div class="flex justify-center mt-8">
				<Button href="/cars" color="white" class:list={"px-8 py-3 text-lg"}>Browse All Cars</Button>
			</div>
		</Container>
	</Section>

	{/* Recent Cars */}
	<Section class:list={"bg-gray-50"}>
		<Container>
			<Heading>
				<h2 slot="heading-title" class="mb-0">Recent inventory</h2>
				<p slot="heading-content">
					Check out the newest additions to our collection. We hand-pick the best vehicles for our
					customers.
				</p>
			</Heading>

			<ShowCars ui="grid" recent />
		</Container>
	</Section>

	{/* CTA */}
	<Section class:list={"bg-gradient-to-br from-gray-900 to-gray-700"}>
		<Container>
			<Heading class:list={"mb-0 lg:mb-0 prose-invert text-center mx-auto"}>
				<h2 slot="heading-title">Can't find the ideal car?</h2>

				<p slot="heading-content">
					Our team is here to help you find the perfect car that suits your needs and budget.
					Whether you're looking for a sleek sports car, a reliable family vehicle, or an
					eco-friendly hybrid, we have something for everyone.
				</p>

				<Button href="/contact" color="white" class:list={"mt-8"}>Contact us</Button>
			</Heading>
		</Container>
	</Section>
</Layout>
