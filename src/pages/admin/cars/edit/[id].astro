---
export const prerender = false;
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import CarEditForm from "~/components/admin/CarEditForm.svelte";
import { getDb } from "~/db/client";
import { cars as carsTable } from "~/db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";

const { id } = Astro.params;
const db = getDb(env);
const car = await db.query.cars.findFirst({
  where: eq(carsTable.id, id as string),
});

if (!car) {
  return Astro.redirect("/admin/cars");
}
---

<Layout pageTitle={`Edit ${car.title}`}>
  <Section class="bg-black min-h-[80vh] py-12">
    <Container>
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-black text-white uppercase tracking-wider">
          <span class="text-gray-500">Edit /</span> {car.title}
        </h1>
        <a
          href="/admin/cars"
          class="text-gray-400 hover:text-white transition flex items-center font-bold tracking-widest text-xs uppercase"
        >
          &larr; Back
        </a>
      </div>

      <CarEditForm client:load {car} />
    </Container>
  </Section>
</Layout>
