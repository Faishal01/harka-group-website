---
export const prerender = false;
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { getDb } from "~/db/client";
import { cars as carsTable } from "~/db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";

const { id } = Astro.params;
const db = getDb(env);
const car = await db.query.cars.findFirst({
  where: eq(carsTable.id, id as string),
});

if (!car) {
  return Astro.redirect("/admin/cars");
}

let error = "";
let success = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const action = formData.get("action");
    if (action === "delete") {
      await db.delete(carsTable).where(eq(carsTable.id, id as string));
      return Astro.redirect("/admin/cars");
    }

    const updateData: any = {};

    // Basic fields
    updateData.title = formData.get("title") as string;
    updateData.image = formData.get("image") as string;
    updateData.imageAlt = formData.get("imageAlt") as string;
    updateData.videoTourUrl = formData.get("videoTourUrl") as string;
    updateData.excerpt = formData.get("excerpt") as string;

    // JSON fields
    const jsonFields = [
      "gallery",
      "general",
      "history",
      "technical",
      "efficiency",
      "options",
      "security",
      "exterior",
      "interior",
      "misc",
    ];
    for (const field of jsonFields) {
      const val = formData.get(field) as string;
      if (val && val.trim() !== "") {
        updateData[field] = JSON.parse(val);
      } else {
        updateData[field] = null;
      }
    }

    await db
      .update(carsTable)
      .set(updateData)
      .where(eq(carsTable.id, id as string));
    success = "Car updated successfully!";

    // Refresh car data
    Object.assign(car, updateData);
  } catch (e: any) {
    error = e.message || "Failed to update car";
  }
}
---

<Layout pageTitle={`Edit ${car.title}`}>
  <Section class="bg-gray-50 min-h-[70vh]">
    <Container>
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Edit Car: {car.title}</h1>
        <a
          href="/admin/cars"
          class="text-gray-600 hover:text-gray-900 transition"
        >
          &larr; Back to Cars
        </a>
      </div>

      {
        error && (
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            {error}
          </div>
        )
      }

      {
        success && (
          <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            {success}
          </div>
        )
      }

      <div class="bg-white rounded-lg shadow overflow-hidden p-6">
        <form method="POST" class="space-y-6">
          <input type="hidden" name="action" value="update" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Title</label
              >
              <input
                type="text"
                name="title"
                required
                value={car.title}
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Excerpt</label
              >
              <input
                type="text"
                name="excerpt"
                value={car.excerpt || ""}
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Image URL</label
              >
              <input
                type="text"
                name="image"
                value={car.image || ""}
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Image Alt</label
              >
              <input
                type="text"
                name="imageAlt"
                value={car.imageAlt || ""}
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Video Tour URL</label
              >
              <input
                type="text"
                name="videoTourUrl"
                value={car.videoTourUrl || ""}
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
          </div>

          <hr class="my-6" />
          <h3 class="text-xl font-bold mb-4">Data (JSON)</h3>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {
              ["general", "history", "technical", "efficiency", "exterior"].map(
                (field) => (
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1 capitalize">
                      {field} *
                    </label>
                    <textarea
                      name={field}
                      required
                      rows="6"
                      class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                    >
                      {JSON.stringify((car as any)[field], null, 2)}
                    </textarea>
                  </div>
                ),
              )
            }
            {
              ["gallery", "options", "security", "interior", "misc"].map(
                (field) => (
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1 capitalize">
                      {field}
                    </label>
                    <textarea
                      name={field}
                      rows="6"
                      class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                    >
                      {(car as any)[field]
                        ? JSON.stringify((car as any)[field], null, 2)
                        : ""}
                    </textarea>
                  </div>
                ),
              )
            }
          </div>

          <div class="flex justify-between mt-8 pt-4 border-t">
            <button
              type="submit"
              class="bg-blue-600 text-white font-semibold py-2 px-6 rounded hover:bg-blue-700 transition"
            >
              Save Changes
            </button>
          </div>
        </form>

        <form
          method="POST"
          class="mt-8 pt-4 border-t"
          onsubmit="return confirm('Are you sure you want to delete this car?');"
        >
          <input type="hidden" name="action" value="delete" />
          <button
            type="submit"
            class="bg-red-600 text-white font-semibold py-2 px-4 rounded hover:bg-red-700 transition text-sm"
          >
            Delete Car
          </button>
        </form>
      </div>
    </Container>
  </Section>
</Layout>
