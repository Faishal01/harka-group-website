---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { getDb } from "~/db/client";
import { cars as carsTable } from "~/db/schema";
import { isNull, isNotNull } from "drizzle-orm";
import { env } from "cloudflare:workers";

const url = new URL(Astro.request.url);
const tab = url.searchParams.get("tab") || "active";

const db = getDb(env);
const allCars = await db.query.cars.findMany({
  where: tab === "archived" ? isNotNull(carsTable.deletedAt) : isNull(carsTable.deletedAt),
  orderBy: (cars, { desc }) => [desc(cars.publishDate)],
});
---

<Layout pageTitle="Admin - Cars">
  <Section class="bg-gray-50 min-h-[70vh]">
    <Container>
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Manage Cars</h1>
        <a
          href="/admin/cars/new"
          class="bg-blue-600 text-white font-semibold py-2 px-4 rounded hover:bg-blue-700 transition"
        >
          + Add New Car
        </a>
      </div>

      <div class="mb-4 border-b border-gray-200">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
          <a
            href="?tab=active"
            class={`${
              tab === "active"
                ? "border-blue-500 text-blue-600"
                : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
            } whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium`}
          >
            Active Cars
          </a>
          <a
            href="?tab=archived"
            class={`${
              tab === "archived"
                ? "border-blue-500 text-blue-600"
                : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
            } whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium`}
          >
            Sold / Archived
          </a>
        </nav>
      </div>

      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Car</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Price</th
              >
              {tab === "active" ? (
                <th
                  class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >Status</th
                >
              ) : (
                <th
                  class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >Date Archived</th
                >
              )}
              <th
                class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
                >Actions</th
              >
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {
              allCars.map((car) => (
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div class="shrink-0 h-10 w-10 bg-gray-200 rounded overflow-hidden">
                        {car.image ? (
                          <img
                            src={car.image}
                            alt={car.imageAlt}
                            class="h-10 w-10 object-cover"
                          />
                        ) : (
                          <div class="h-10 w-10 bg-gray-300" />
                        )}
                      </div>
                      <div class="ml-4">
                        <div class="text-sm font-medium text-gray-900">
                          {car.title}
                        </div>
                        <div class="text-sm text-gray-500">
                          {car.general.make} {car.general.model}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900">
                      ${car.general.price.toLocaleString()}
                    </div>
                  </td>
                  
                  {tab === "active" ? (
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span
                        class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${car.misc?.hidden ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800"}`}
                      >
                        {car.misc?.hidden ? "Hidden" : "Visible"}
                      </span>
                    </td>
                  ) : (
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="font-medium text-gray-900">
                        {car.archiveReason === 'sold' ? (
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Sold</span>
                        ) : (
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">Removed</span>
                        )}
                      </div>
                      <div class="text-xs text-gray-500 mt-1">
                        {car.deletedAt ? car.deletedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : "Unknown"}
                      </div>
                    </td>
                  )}

                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div class="flex justify-end gap-3 items-center">
                      {car.deletedAt ? (
                        <>
                          <button 
                            type="button"
                            class="text-green-600 hover:text-green-900 restore-btn"
                            data-id={car.id}
                          >
                            Restore
                          </button>
                          <a
                            href={`/admin/cars/view/${car.id}`}
                            class="text-blue-600 hover:text-blue-900"
                          >
                            View
                          </a>
                        </>
                      ) : (
                        <div class="flex items-center gap-4">
                          <a
                            href={`/admin/cars/edit/${car.id}`}
                            class="text-blue-600 hover:text-blue-900 font-semibold"
                          >
                            Edit
                          </a>
                          
                          <div class="relative group">
                            <button class="text-gray-500 hover:text-gray-700 flex items-center font-medium">
                              Quick Actions 
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                              </svg>
                            </button>
                            <!-- Dropdown Menu -->
                            <div class="absolute right-0 mt-2 w-40 bg-white rounded-md shadow-lg border border-gray-200 z-10 hidden group-hover:block group-focus-within:block">
                              <div class="py-1">
                                <button type="button" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 quick-archive-btn" data-id={car.id} data-reason="sold">
                                  Mark Sold
                                </button>
                                <button type="button" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 quick-archive-btn" data-id={car.id} data-reason="removed">
                                  Remove from List
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                  </td>
                </tr>
              ))
            }
            {
              allCars.length === 0 && (
                <tr>
                  <td colspan="4" class="px-6 py-4 text-center text-gray-500">
                    No cars found in this view.
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
    </Container>
  </Section>

  <script>
    document.querySelectorAll('.restore-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        if (confirm('Are you sure you want to restore this car back to active status?')) {
          const res = await fetch(`/api/cars/${id}/restore`, { method: 'POST' });
          if (res.ok) window.location.reload();
          else alert('Failed to restore vehicle.');
        }
      });
    });

    document.querySelectorAll('.quick-archive-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.dataset.id;
        const reason = target.dataset.reason;
        
        const actionText = reason === 'sold' ? 'Mark this car as SOLD' : 'REMOVE this car from the active list';
        
        if (confirm(`Are you sure you want to ${actionText}?`)) {
          const res = await fetch(`/api/cars/${id}?reason=${reason}`, { method: 'DELETE' });
          if (res.ok) window.location.reload();
          else alert('Failed to archive vehicle.');
        }
      });
    });
  </script>
</Layout>
