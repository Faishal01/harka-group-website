---
export const prerender = false;
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import CarWizard from "~/components/admin/CarWizard.svelte";
---

<Layout pageTitle="Add New Car">
	<Section class="bg-gray-50 min-h-[70vh] py-12">
		<Container>
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-3xl font-bold text-gray-900">Add New Car</h1>
				<a
					href="/admin/cars"
					class="text-gray-500 hover:text-gray-700 transition flex items-center font-medium"
				>
					&larr; Back to Cars
				</a>
			</div>

			<CarWizard client:load />
		</Container>
	</Section>
</Layout>
