---
export const prerender = false;
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { getDb } from "~/db/client";
import { cars as carsTable } from "~/db/schema";
import slugify from "slugify";
import { env } from "cloudflare:workers";

let error = "";

const defaultGeneral = {
  make: "Toyota",
  model: "Camry",
  price: 25000,
  bodyType: "Sedan",
  doors: 4,
  seatingCapacity: 5,
  availability: "in-stock",
};

const defaultHistory = {
  mileage: 0,
  year: new Date().getFullYear(),
};

const defaultTechnical = {
  horsePower: 200,
  transmission: "Automatic",
  engineSizeCC: 2500,
};

const defaultEfficiency = {
  fuelType: "Petrol",
};

const defaultExterior = {
  color: "Black",
};

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const title = formData.get("title") as string;
    if (!title) throw new Error("Title is required");

    const slug =
      slugify(title, { lower: true, strict: true }) +
      "-" +
      Math.floor(Math.random() * 1000);

    let imageUrl = null;
    const imageFile = formData.get("imageFile") as File | null;
    if (imageFile && imageFile.size > 0) {
      const arrayBuffer = await imageFile.arrayBuffer();
      const ext = imageFile.name.split('.').pop();
      const filename = `${slug}-${Date.now()}.${ext}`;
      await env.IMAGES_BUCKET.put(filename, arrayBuffer, {
        httpMetadata: { contentType: imageFile.type }
      });
      imageUrl = `/api/images/${filename}`;
    }

    const insertData: any = {
      id: slug,
      title: title,
      image: imageUrl,
      imageAlt: (formData.get("imageAlt") as string) || null,
      videoTourUrl: (formData.get("videoTourUrl") as string) || null,
      excerpt: (formData.get("excerpt") as string) || null,
      publishDate: new Date(),
    };

    // JSON fields
    const jsonFields = [
      "gallery",
      "general",
      "history",
      "technical",
      "efficiency",
      "options",
      "security",
      "exterior",
      "interior",
      "misc",
    ];
    for (const field of jsonFields) {
      const val = formData.get(field) as string;
      if (val && val.trim() !== "") {
        insertData[field] = JSON.parse(val);
      } else {
        insertData[field] = null;
      }
    }

    const db = getDb(env);
    await db.insert(carsTable).values(insertData);

    return Astro.redirect(`/admin/cars`);
  } catch (e: any) {
    error = e.message || "Failed to create car";
  }
}
---

<Layout pageTitle="Add New Car">
  <Section class="bg-gray-50 min-h-[70vh]">
    <Container>
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Add New Car</h1>
        <a
          href="/admin/cars"
          class="text-gray-600 hover:text-gray-900 transition"
        >
          &larr; Back to Cars
        </a>
      </div>

      {
        error && (
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            {error}
          </div>
        )
      }

      <div class="bg-white rounded-lg shadow overflow-hidden p-6">
        <form method="POST" enctype="multipart/form-data" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Title *</label
              >
              <input
                type="text"
                name="title"
                required
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Excerpt</label
              >
              <input
                type="text"
                name="excerpt"
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Upload Image</label
              >
              <input
                type="file"
                name="imageFile"
                accept="image/*"
                class="w-full p-1.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Image Alt</label
              >
              <input
                type="text"
                name="imageAlt"
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Video Tour URL</label
              >
              <input
                type="text"
                name="videoTourUrl"
                class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none"
              />
            </div>
          </div>

          <hr class="my-6" />
          <h3 class="text-xl font-bold mb-4">Data (JSON)</h3>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1"
                >General *</label
              >
              <textarea
                name="general"
                required
                rows="6"
                class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                >{JSON.stringify(defaultGeneral, null, 2)}</textarea
              >
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1"
                >History *</label
              >
              <textarea
                name="history"
                required
                rows="6"
                class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                >{JSON.stringify(defaultHistory, null, 2)}</textarea
              >
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1"
                >Technical *</label
              >
              <textarea
                name="technical"
                required
                rows="6"
                class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                >{JSON.stringify(defaultTechnical, null, 2)}</textarea
              >
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1"
                >Efficiency *</label
              >
              <textarea
                name="efficiency"
                required
                rows="6"
                class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                >{JSON.stringify(defaultEfficiency, null, 2)}</textarea
              >
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1"
                >Exterior *</label
              >
              <textarea
                name="exterior"
                required
                rows="6"
                class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                >{JSON.stringify(defaultExterior, null, 2)}</textarea
              >
            </div>

            {
              ["gallery", "options", "security", "interior", "misc"].map(
                (field) => (
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1 capitalize">
                      {field}
                    </label>
                    <textarea
                      name={field}
                      rows="6"
                      class="w-full p-2 border rounded font-mono text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                    />
                  </div>
                ),
              )
            }
          </div>

          <div class="flex justify-between mt-8 pt-4 border-t">
            <button
              type="submit"
              class="bg-blue-600 text-white font-semibold py-2 px-6 rounded hover:bg-blue-700 transition"
            >
              Create Car
            </button>
          </div>
        </form>
      </div>
    </Container>
  </Section>
</Layout>
