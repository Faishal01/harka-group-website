---
export const prerender = false;
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import CarWizard from "~/components/admin/CarWizard.svelte";
---

<Layout pageTitle="Add New Car">
  <Section class="bg-black min-h-[80vh] py-12">
    <Container>
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-black text-white uppercase tracking-wider">Vehicle <span class="text-red-600">Provisioning</span></h1>
        <a
          href="/admin/cars"
          class="text-gray-400 hover:text-white transition flex items-center font-bold tracking-widest text-xs uppercase"
        >
          &larr; Abort
        </a>
      </div>

      <CarWizard client:load />

    </Container>
  </Section>
</Layout>
